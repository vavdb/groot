@* Rendered once per theme column. All example data lives here, not in the components. *@

<section class="section">
    <h2>BottomNav</h2>
    <div class="caption">phone chrome · every destination, and the subset the phone head ships</div>
    <div class="stack">
        <BottomNav Selected="GrootDestination.Home" />
        <BottomNav Selected="GrootDestination.Run" Destinations="Shipping" />
    </div>
</section>

<section class="section">
    <h2>GrootPanel</h2>
    <div class="caption">outlined · what you read</div>
    <div class="stack">
        <GrootPanel Title="This week" Meta="4 of 4">
            <MudText Typo="Typo.body2">A panel with a label and a reading. Border, radius and padding come from the panel, never from the block inside it.</MudText>
        </GrootPanel>
        <div class="caption">filled · what you are working through</div>
        <GrootPanel Filled="true" Title="Squat" Meta="60 kg">
            <div class="row">
                <SetCircle State="SetCircleState.Done" Reps="3" />
                <SetCircle State="SetCircleState.Active" Reps="3" />
                <SetCircle State="SetCircleState.Pending" />
            </div>
        </GrootPanel>
        <div class="caption">no header</div>
        <GrootPanel>
            <MudText Typo="Typo.body2">Header parts are optional; the surface is not.</MudText>
        </GrootPanel>
    </div>
</section>

<section class="section">
    <h2>GrootStats</h2>
    <div class="caption">the reading line a session screen ends with</div>
    <div class="stack">
        <GrootStats>
            <GrootStat Label="elapsed" Value="4:12" />
            <GrootStat Label="segment" Value="7/18" />
            <GrootStat Label="total" Value="30:00" />
        </GrootStats>
        <GrootStats>
            <GrootStat Label="sets" Value="5/11" />
            <GrootStat Label="reps" Value="15" />
            <GrootStat Label="volume" Value="900 kg" />
        </GrootStats>
    </div>
</section>

<section class="section">
    <h2>GrootChoice</h2>
    <div class="caption">one choice from a short list · the dropdown opens in the shell theme</div>
    <div class="row">
        <GrootChoice T="string" Label="Program" Items="@(new[] { "0-to-5k", "gzclp-rack" })" Value="@_program"
                     Display="@(id => id == "gzclp-rack" ? "GZCLP" : "0→5K")"
                     ValueChanged="@(id => _program = id)" />
        <GrootChoice T="int" Label="Week" Items="@(new[] { 1, 2, 3 })" Value="@_week"
                     Display="@(week => $"Week {week}")" ValueChanged="@(week => _week = week)" />
    </div>
</section>

<section class="section">
    <h2>SeasonGrid</h2>
    <div class="caption">26 weeks · a cell per day, weeks left to right, today ringed</div>
    <div class="stack">
        <div>
            <div class="caption">a training year</div>
            <SeasonGrid Days="DenseHistory" Today="Monday" />
        </div>
        <div>
            <div class="caption">a few weeks in</div>
            <SeasonGrid Days="SparseHistory" Today="Monday" />
        </div>
        <div>
            <div class="caption">nothing logged yet, the home screen before a first session</div>
            <SeasonGrid Days="@(Array.Empty<SeasonDay>())" Today="Monday" />
        </div>
    </div>
</section>

<section class="section">
    <h2>SetCircle</h2>
    <div class="caption">session in progress · tap = logged</div>
    <div class="row">
        <SetCircle State="SetCircleState.Done" Reps="3" />
        <SetCircle State="SetCircleState.Done" Reps="3" />
        <SetCircle State="SetCircleState.Active" Reps="3" />
        <SetCircle State="SetCircleState.Pending" />
        <SetCircle State="SetCircleState.Pending" />
    </div>
    <div class="caption">single states: done (logged reps) · active (target) · pending · missed (short of target) · done with AMRAP overshoot</div>
    <div class="row">
        <SetCircle State="SetCircleState.Done" Reps="10" />
        <SetCircle State="SetCircleState.Active" Reps="5" />
        <SetCircle State="SetCircleState.Pending" />
        <SetCircle State="SetCircleState.Missed" Reps="1" />
        <SetCircle State="SetCircleState.Done" Reps="14" />
    </div>
</section>

<section class="section">
    <h2>HeartRateTrace</h2>
    <div class="caption">
        the line is the heart rate, its colour is the zone, the bands are the run and walk blocks ·
        SegmentBar sits under each one to show the two stay aligned
    </div>
    <div class="stack phone-width">
        <div>
            <div class="caption">one device · 19 minutes into a 30 minute session</div>
            <HeartRateTrace Trace="MidSession.View()" Segments="RunSegments" ElapsedSeconds="1140" />
            <SegmentBar Segments="RunSegments" SegmentIndex="11" Started="true" />
        </div>
        <div>
            <div class="caption">two devices · the dashed line is the second one</div>
            <HeartRateTrace Trace="MidSession.View()" Second="SecondDevice.View()"
                            Segments="RunSegments" ElapsedSeconds="1140" />
            <SegmentBar Segments="RunSegments" SegmentIndex="11" Started="true" />
        </div>
        <div>
            <div class="caption">connected, no reading yet · bands only, and the strip keeps its height</div>
            <HeartRateTrace Trace="HeartRateTraceView.Empty(48)" Segments="RunSegments" ElapsedSeconds="0" />
            <SegmentBar Segments="RunSegments" SegmentIndex="0" />
        </div>
        <div>
            <div class="caption">session finished · every zone the run passed through</div>
            <HeartRateTrace Trace="WholeSession.View()" Segments="RunSegments" ElapsedSeconds="1800" />
            <SegmentBar Segments="RunSegments" SegmentIndex="17" Started="true" Finished="true" />
        </div>
        <div>
            <div class="caption">a hard session · the top two zones, which is where clay and pulse-peak have to separate</div>
            <HeartRateTrace Trace="HardSession.View()" Segments="RunSegments" ElapsedSeconds="1800" />
            <SegmentBar Segments="RunSegments" SegmentIndex="17" Started="true" Finished="true" />
        </div>
    </div>
</section>

<section class="section">
    <h2>RouteMap</h2>
    <div class="caption">
        run blocks thick and coloured by heart rate zone, walks a thin thread · there is no route
        ahead to draw, because a map cannot know where the runner has not been yet
    </div>
    <div class="stack phone-width">
        <div>
            <div class="caption">mid-session, monitor connected</div>
            <RouteMap Route="PartRoute.View()" Segments="RunSegments" />
        </div>
        <div>
            <div class="caption">finished · the whole loop</div>
            <RouteMap Route="WholeRoute.View()" Segments="RunSegments" />
        </div>
        <div>
            <div class="caption">no monitor · without a heart rate there are no zones, so run blocks stay one colour</div>
            <RouteMap Route="RouteWithoutHeartRate.View()" Segments="RunSegments" />
        </div>
        <div>
            <div class="caption">the fix dropped for a minute · the join is dashed, not claimed as ground covered</div>
            <RouteMap Route="RouteWithGap.View()" Segments="RunSegments" />
        </div>
        <div>
            <div class="caption">no fix yet</div>
            <RouteMap Route="RouteTraceView.Empty" Segments="RunSegments" />
        </div>
    </div>
</section>

<section class="section">
    <h2>SourceChips</h2>
    <div class="caption">
        what the session is listening to, and the whole control surface for it · a chip is the tap
        target, so there is no Connect button competing with Start
    </div>
    <div class="stack">
        <div>
            <div class="caption">both off · the run screen as it was before any of this</div>
            <SourceChips />
        </div>
        <div>
            <div class="caption">on, nothing connected yet · the ordinary first half minute</div>
            <SourceChips HeartRateEnabled="true" LocationEnabled="true" LocationState="SensorState.Searching" />
        </div>
        <div>
            <div class="caption">one monitor and a fix</div>
            <SourceChips HeartRateEnabled="true" LocationEnabled="true"
                         LocationState="SensorState.Live" DistanceKm="2.43"
                         Devices="@(new HeartRateDevice[] { new("a", "Amazfit", SensorState.Live, 148) })" />
        </div>
        <div>
            <div class="caption">two monitors</div>
            <SourceChips HeartRateEnabled="true" LocationEnabled="true"
                         LocationState="SensorState.Live" DistanceKm="2.43"
                         Devices="@(new HeartRateDevice[]
                         {
                             new("a", "Amazfit", SensorState.Live, 148),
                             new("b", "Fitbit Air", SensorState.Live, 151),
                         })" />
        </div>
        <div>
            <div class="caption">trouble · one watch stopped sharing, and location was refused</div>
            <SourceChips HeartRateEnabled="true" LocationEnabled="true"
                         LocationState="SensorState.Denied"
                         LocationTrouble="Groot needs the Location permission to record where you ran."
                         Devices="@(new HeartRateDevice[]
                         {
                             new("a", "Amazfit", SensorState.Lost, null),
                             new("b", "Fitbit Air", SensorState.Searching, null),
                         })" />
        </div>
        <div>
            <div class="caption">
                the radio is off · without this line the chip reads exactly like "no watch in range",
                and someone walks outside to test a radio that was never switched on
            </div>
            <SourceChips HeartRateEnabled="true" LocationEnabled="true"
                         LocationState="SensorState.Searching"
                         HeartRateTrouble="Bluetooth is switched off." />
        </div>
    </div>
</section>

<section class="section">
    <h2>WeekCard</h2>
    <div class="stack">
        <div>
            <div class="caption">on track · Friday morning, run planned today</div>
            <WeekCard Days="OnTrackDays" Evaluation="OnTrackEval" />
        </div>
        <div>
            <div class="caption">joker week · Thursday lift missed, joker spent</div>
            <WeekCard Days="JokerDays" Evaluation="JokerEval" />
        </div>
        <div>
            <div class="caption">broken week · one run only, jokers cannot cover</div>
            <WeekCard Days="BrokenDays" Evaluation="BrokenEval" />
        </div>
    </div>
</section>

@code {
    // ---- HeartRateTrace samples -------------------------------------------------
    // A 0→5K week 1 session: five minutes of warmup, eight run blocks, five of cooldown.

    private const int SessionSeconds = 1800;

    /// <summary>The same segment list the trace bands and the segment bar are both drawn from.</summary>
    private static readonly Segment[] RunSegments =
    [
        new(SegmentKind.Walk, 300, "warmup"),
        .. Enumerable.Range(0, 8).SelectMany(_ => new[]
        {
            new Segment(SegmentKind.Run, 60),
            new Segment(SegmentKind.Walk, 90),
        }),
        new(SegmentKind.Walk, 300, "cooldown"),
    ];

    /// <summary>Walks settle towards a floor, runs climb towards a ceiling, and the whole thing drifts up.</summary>
    private static int SampleBpm(int second, int lift)
    {
        var at = 0;
        foreach (var segment in RunSegments)
        {
            at += segment.Seconds;
            if (second >= at) continue;

            var into = second - (at - segment.Seconds);
            var drift = Math.Min(18, second / 70);
            return segment.Kind == SegmentKind.Run
                ? 112 + lift + drift + (int)(34 * Math.Min(1, into / 45.0))
                : 96 + lift + drift + (int)(34 * Math.Max(0, 1 - into / 55.0));
        }

        return 96 + lift;
    }

    private static HeartRateTrack Filled(int throughSecond, int lift = 0, int everySeconds = 5)
    {
        var track = new HeartRateTrack(SessionSeconds, buckets: 48);
        for (var second = 0; second <= throughSecond; second += everySeconds)
            track.Add(second, SampleBpm(second, lift));

        return track;
    }

    private static readonly HeartRateTrack MidSession = Filled(1140);

    // A second watch on the same body: a few beats off, and reporting half as often.
    private static readonly HeartRateTrack SecondDevice = Filled(1140, lift: 4, everySeconds: 10);

    private static readonly HeartRateTrack WholeSession = Filled(SessionSeconds);

    // The same session run 30 bpm harder, so the trace reaches the hard and maximum zones.
    private static readonly HeartRateTrack HardSession = Filled(SessionSeconds, lift: 30);

    // ---- RouteMap samples ---------------------------------------------------------
    // A lumpy loop rather than a circle, so it reads as streets rather than a running track.
    // Run blocks cover roughly twice the ground per second that walk blocks do.

    private const double StartLatitude = 52.37;
    private const double StartLongitude = 4.90;

    private static bool RunningAt(int second)
    {
        var at = 0;
        foreach (var segment in RunSegments)
        {
            at += segment.Seconds;
            if (second < at) return segment.Kind == SegmentKind.Run;
        }

        return false;
    }

    private static RouteTrack Loop(int throughSecond, bool withHeartRate = true, (int From, int To)? gap = null)
    {
        var track = new RouteTrack();
        var along = 0.0;

        for (var second = 0; second <= throughSecond; second += 3)
        {
            if (gap is { } lost && second >= lost.From && second <= lost.To) continue;

            along += RunningAt(second) ? 0.0019 : 0.001;
            var angle = along * Math.PI * 2;
            var radius = 1
                + 0.30 * Math.Sin(angle * 2 + 0.6)
                + 0.16 * Math.Sin(angle * 3 - 1.1);

            track.Add(new RouteFix(
                second,
                StartLatitude + Math.Sin(angle - Math.PI / 2) * radius * 0.0042,
                StartLongitude + Math.Cos(angle - Math.PI / 2) * radius * 0.0085,
                AccuracyMetres: 7,
                Bpm: withHeartRate ? SampleBpm(second, 0) : null));
        }

        return track;
    }

    private static readonly RouteTrack PartRoute = Loop(1140);

    private static readonly RouteTrack WholeRoute = Loop(SessionSeconds);

    private static readonly RouteTrack RouteWithoutHeartRate = Loop(SessionSeconds, withHeartRate: false);

    private static readonly RouteTrack RouteWithGap = Loop(SessionSeconds, gap: (900, 960));

    /// <summary>What the phone head offers today: Progress has no screen yet.</summary>
    private static readonly GrootDestination[] Shipping =
        [GrootDestination.Run, GrootDestination.Home, GrootDestination.Lift];

    private string _program = "0-to-5k";
    private int _week = 1;

    private static readonly DateOnly Monday = new(2026, 8, 17);

    private static readonly SeasonDay[] DenseHistory = SampleHistory.Weeks(Monday);

    // The first three weeks of a habit.
    private static readonly SeasonDay[] SparseHistory =
        Enumerable.Range(0, 21)
            .Select(offset => Monday.AddDays(-20 + offset))
            .Where(date => date.DayOfWeek is DayOfWeek.Monday or DayOfWeek.Wednesday or DayOfWeek.Saturday)
            .Select(date => new SeasonDay(date, 1))
            .ToArray();
    private static readonly WeekContract Contract = new();

    private static ContractSession Lift(int d) => new(Monday.AddDays(d), SessionKind.Lift);
    private static ContractSession Run(int d) => new(Monday.AddDays(d), SessionKind.Run);

    // on track: Mon run, Tue lift, Wed run done; Fri = today
    private static readonly WeekEvaluation OnTrackEval =
        ContractEvaluator.Evaluate(Monday, new[] { Run(0), Lift(1), Run(2), Lift(3) }, Contract);

    private static readonly DaySlot[] OnTrackDays =
    [
        new("MO", "●", "RUN", DaySlotVisual.RunDone),
        new("TU", "▲", "LIFT", DaySlotVisual.LiftDone),
        new("WE", "●", "RUN", DaySlotVisual.RunDone),
        new("TH", "▲", "LIFT", DaySlotVisual.LiftDone),
        new("FR", "▶", "RUN", DaySlotVisual.Today),
        new("SA", "·", "LIFT", DaySlotVisual.Pending),
        new("SU", "☾", "REST", DaySlotVisual.Rest),
    ];

    // joker week: Thursday lift missed
    private static readonly WeekEvaluation JokerEval =
        ContractEvaluator.Evaluate(Monday, new[] { Run(0), Lift(1), Run(2) }, Contract);

    private static readonly DaySlot[] JokerDays =
    [
        new("MO", "●", "RUN", DaySlotVisual.RunDone),
        new("TU", "▲", "LIFT", DaySlotVisual.LiftDone),
        new("WE", "●", "RUN", DaySlotVisual.RunDone),
        new("TH", "◆", "JOKER", DaySlotVisual.Joker),
        new("FR", "·", "RUN", DaySlotVisual.Pending),
        new("SA", "·", "LIFT", DaySlotVisual.Pending),
        new("SU", "☾", "REST", DaySlotVisual.Rest),
    ];

    // broken: one run, three credits missing, two jokers cannot cover
    private static readonly WeekEvaluation BrokenEval =
        ContractEvaluator.Evaluate(Monday, new[] { Run(0) }, Contract);

    private static readonly DaySlot[] BrokenDays =
    [
        new("MO", "●", "RUN", DaySlotVisual.RunDone),
        new("TU", "·", "", DaySlotVisual.Pending),
        new("WE", "·", "", DaySlotVisual.Pending),
        new("TH", "·", "", DaySlotVisual.Pending),
        new("FR", "·", "", DaySlotVisual.Pending),
        new("SA", "·", "", DaySlotVisual.Pending),
        new("SU", "☾", "REST", DaySlotVisual.Rest),
    ];
}
