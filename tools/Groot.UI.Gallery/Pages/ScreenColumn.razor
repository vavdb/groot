@* Every app screen for one theme, in the order a person meets them. The screens are the head
   page bodies verbatim; the app bar and drawer around them come from GrootShell, which the
   gallery already renders once, so the frames below show the body only. *@
@using Groot.Core.Programs

<span class="theme-label">@(IsDark ? "Dark" : "Light")</span>

<ScreenFrame Name="Boot" Note="both heads · index.html, rings turning into the loaded bar">
    <BootMark />
</ScreenFrame>

<ScreenFrame Name="Boot, pith kept" Note="not shipped · the brown dot rides the shaft instead of handing over">
    <BootMark Variant="g-turn-dot" />
</ScreenFrame>

<div class="icon-set">
    <div class="screen-head">
        <span class="screen-name">App icon</span>
        <span class="screen-note">the two ends of the turn, frozen, then the bar with the pith kept</span>
    </div>
    <div class="icon-row">
        <div class="icon-tile lg"><BootMark Variant="g-icon-rings" /></div>
        <div class="icon-tile sm"><BootMark Variant="g-icon-rings" /></div>
        <div class="icon-tile lg"><BootMark Variant="g-icon-barbell" /></div>
        <div class="icon-tile sm"><BootMark Variant="g-icon-barbell" /></div>
        <div class="icon-tile lg"><BootMark Variant="g-icon-barbell-dot" /></div>
        <div class="icon-tile sm"><BootMark Variant="g-icon-barbell-dot" /></div>
    </div>
</div>

<ScreenFrame Name="Home" Note="both heads · GrootLanding" Nav="GrootDestination.Home">
    <GrootLanding />
</ScreenFrame>

<ScreenFrame Name="Run" Note="phone head · one program, cues silent in the gallery" Nav="GrootDestination.Run">
    <GrootRunScene Programs="CouchPrograms" ShowProgram="false" ShowAudioControls="false" />
</ScreenFrame>

<ScreenFrame Name="Run" Note="web head · program picker and voice controls, desktop width" Wide="true">
    <GrootRunScene Programs="AllPrograms" ShowProgram="true" ShowAudioControls="true" />
</ScreenFrame>

<ScreenFrame Name="Lift" Note="both heads · GZCLP day A1, tap a circle to log the set" Nav="GrootDestination.Lift">
    <GrootLiftScene />
</ScreenFrame>

<ScreenFrame Name="Not found" Note="both heads · GrootNotFound">
    <GrootNotFound />
</ScreenFrame>

@code {
    [Parameter] public bool IsDark { get; set; }

    private static readonly DateOnly Today = new(2026, 8, 22);

    /// <summary>Six months of plausible training: four sessions most weeks, two lean stretches,
    /// the odd double day. Deterministic, so the gallery looks the same on every render.</summary>
    private static readonly SeasonDay[] SampleHistory = SampleWeeks();

    private static SeasonDay[] SampleWeeks()
    {
        var monday = Today.AddDays(-(((int)Today.DayOfWeek + 6) % 7)).AddDays(-25 * 7);
        var days = new List<SeasonDay>();

        for (var week = 0; week < 26; week++)
        {
            // Two lean weeks in February and one in June: travel, a cold, a deload.
            var lean = week is 7 or 8 or 19;
            var planned = lean ? 1 : week % 5 == 0 ? 5 : 4;

            // Which days of the week, rotated so the pattern does not stripe.
            var offsets = new[] { 0, 2, 4, 5, 1, 3 }.Skip(week % 3).Take(planned).ToArray();

            foreach (var offset in offsets)
            {
                var date = monday.AddDays(week * 7 + offset);
                if (date > Today) continue;
                var sessions = (week * 7 + offset) % 17 == 0 ? 2 : 1;
                days.Add(new SeasonDay(date, sessions));
            }
        }

        return days.ToArray();
    }

    private static readonly IReadOnlyList<IntervalProgram> AllPrograms =
        ProgramCatalog.Embedded.IntervalPrograms;

    private static readonly IReadOnlyList<IntervalProgram> CouchPrograms =
        [ ProgramCatalog.Embedded.IntervalProgram("0-to-5k") ];
}
