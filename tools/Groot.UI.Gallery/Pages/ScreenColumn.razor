@* Every app screen for one theme, in the order a person meets them. The screens are the head
   page bodies verbatim; the app bar and drawer around them come from GrootShell, which the
   gallery already renders once, so the frames below show the body only. *@
@using Groot.Core.Programs

<span class="theme-label">@(IsDark ? "Dark" : "Light")</span>

<ScreenFrame Name="Boot" Note="both heads · index.html, rings turning into the loaded bar">
    @* Same mark as the two index.html boot blocks, styled by boot-loader.css. Different wrapper
       class: .g-boot inside the running app would re-arm the #app:has(.g-boot) full-screen rule.
       check-rules.sh compares this <svg> against both index.html blocks. *@
    <div class="g-boot-demo">
        <svg class="g-boot-rings" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
            <line class="g-bar" x1="14%" y1="50%" x2="86%" y2="50%" />
            <circle class="g-ring g-ring-2 g-plate g-far" cx="50%" cy="50%" r="30%" />
            <circle class="g-ring g-ring-2 g-plate g-near" cx="50%" cy="50%" r="30%" />
            <circle class="g-ring g-ring-1 g-plate g-far" cx="50%" cy="50%" r="17%" />
            <circle class="g-ring g-ring-1 g-plate g-near" cx="50%" cy="50%" r="17%" />
            <circle class="g-ring-track" cx="50%" cy="50%" r="44%" />
            <circle class="g-ring-progress" cx="50%" cy="50%" r="44%" />
            <circle class="g-pith" cx="50%" cy="50%" r="6%" />
        </svg>
    </div>
</ScreenFrame>

<ScreenFrame Name="Home" Note="both heads · GrootLanding" Nav="GrootDestination.Home">
    <GrootLanding />
</ScreenFrame>

<ScreenFrame Name="Run" Note="phone head · one program, cues silent in the gallery" Nav="GrootDestination.Run">
    <GrootRunScene Programs="CouchPrograms" ShowProgram="false" ShowAudioControls="false" />
</ScreenFrame>

<ScreenFrame Name="Run" Note="web head · program picker and voice controls, desktop width" Wide="true">
    <GrootRunScene Programs="AllPrograms" ShowProgram="true" ShowAudioControls="true" />
</ScreenFrame>

<ScreenFrame Name="Not found" Note="both heads · GrootNotFound">
    <GrootNotFound />
</ScreenFrame>

@code {
    [Parameter] public bool IsDark { get; set; }

    private static readonly IReadOnlyList<IntervalProgram> AllPrograms =
        ProgramCatalog.Embedded.IntervalPrograms;

    private static readonly IReadOnlyList<IntervalProgram> CouchPrograms =
        [ ProgramCatalog.Embedded.IntervalProgram("0-to-5k") ];
}
