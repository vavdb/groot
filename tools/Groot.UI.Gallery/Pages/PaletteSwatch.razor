@* One colour swatch: the chip paints from the token itself, the label shows the resolved hex. *@

<div class="swatch">
    <div class="swatch-chip" style="background: var(--g-@Name)"></div>
    <div class="swatch-meta">
        <span class="swatch-name">--g-@Name</span>
        <span class="swatch-hex">@Value</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
}