@* Four samplings of the same quarter turn, side by side, so the stepping is comparable.
   The variants live in the gallery's app.css; only the winner moves into boot-loader.css. *@
@page "/boot"

<PageTitle>Groot.UI — Boot lab</PageTitle>

<div class="ds">
    <header class="ds-head">
        <h1 class="g-serif">Boot lab<span class="accent">.</span></h1>
        <p class="sub">The mark turns from the rings to the loaded bar. The only difference below is how many angles the turn is sampled at: three is what ships. All four share the same 5.4s cycle, and the outer ring sweeps 0 to 100 the way it does while Blazor loads.</p>
    </header>

    <div class="duo">
        <div class="theme-light theme-col">
            <span class="theme-label">Light</span>
            <div class="lab">
                @foreach (var (turn, name, note) in Variants)
                {
                    <div class="lab-cell">
                        <BootMark Turn="@turn" />
                        <div class="caption">@name · @note</div>
                    </div>
                }
            </div>
        </div>
        <div class="theme-dark theme-col">
            <span class="theme-label">Dark</span>
            <div class="lab">
                @foreach (var (turn, name, note) in Variants)
                {
                    <div class="lab-cell">
                        <BootMark Turn="@turn" />
                        <div class="caption">@name · @note</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly (string Turn, string Name, string Note)[] Variants =
    [
        ("", "3 steps", "0, 45, 90 · ships today"),
        ("g-turn-4", "4 steps", "0, 30, 60, 90"),
        ("g-turn-5", "5 steps", "0, 22.5, 45, 67.5, 90"),
        ("g-turn-smooth", "smooth", "every 15 degrees, one ease over the cycle"),
    ];
}
