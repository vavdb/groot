@* The boot mark, exactly as the two index.html blocks render it, styled by boot-loader.css.
   The wrapper class differs on purpose: .g-boot inside the running app would re-arm the
   #app:has(.g-boot) full-screen rule. check-rules.sh compares the <svg> below against both
   index.html blocks, so keep it identical; Variant carries the frozen icon states instead. *@

<div class="g-boot-demo @Variant">
    <svg class="g-boot-rings" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <line class="g-bar" x1="14%" y1="50%" x2="86%" y2="50%" />
        <circle class="g-ring g-ring-2 g-plate g-far" cx="50%" cy="50%" r="30%" />
        <circle class="g-ring g-ring-2 g-plate g-near" cx="50%" cy="50%" r="30%" />
        <circle class="g-ring g-ring-1 g-plate g-far" cx="50%" cy="50%" r="17%" />
        <circle class="g-ring g-ring-1 g-plate g-near" cx="50%" cy="50%" r="17%" />
        <circle class="g-ring-track" cx="50%" cy="50%" r="44%" />
        <circle class="g-ring-progress" cx="50%" cy="50%" r="44%" />
        <circle class="g-pith" cx="50%" cy="50%" r="6%" />
    </svg>
</div>

@code {
    /// <summary>Variant class on the wrapper (g-icon-rings, g-icon-barbell). Empty animates, as it boots.</summary>
    [Parameter] public string Variant { get; set; } = "";
}
