@page "/"

<PageTitle>Groot.UI — Design System</PageTitle>

<div class="ds">
    <header class="ds-head">
        <h1 class="g-serif">Groot.UI<span class="accent">.</span></h1>
        <p class="sub">Design system. Light on the left, dark on the right, one token source (GrootPalette → tokens.css) for our components and for MudBlazor chrome alike.</p>
    </header>

    <div class="duo">
        <div class="theme-light theme-col">
            <GalleryColumn IsDark="false" />
        </div>
        <div class="theme-dark theme-col">
            <GalleryColumn IsDark="true" />
        </div>
    </div>
</div>