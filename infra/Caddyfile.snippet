# Groot API + the Blazor WASM PWA
the app host {
    encode gzip

    # Groot.Api (auth + sync), localhost only behind Caddy
    handle /api/* {
        reverse_proxy 127.0.0.1:5000
    }

    # Blazor WASM static files (publish output), once Groot.Web ships
    handle {
        root * /var/www/groot
        try_files {path} /index.html
        file_server
    }
}
