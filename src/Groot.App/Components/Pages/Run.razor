@page "/run"
@implements IDisposable

@* The run screen itself is not here. It is mounted once in MainLayout and stays mounted, so a
   session keeps running while you look at the week or log a lift; this page is the address that
   brings it back into view. What is left here is what belongs to being on the screen: the phone
   stays awake while the run is the thing being looked at. *@

<PageTitle>Run · Groot</PageTitle>

@code {
    protected override void OnInitialized()
    {
        // Foreground location stops when the app goes to the background, and a phone locks
        // itself a minute into a warmup. Until there is a foreground service, the display stays
        // awake while this screen is open.
        DeviceDisplay.Current.KeepScreenOn = true;
    }

    public void Dispose() => DeviceDisplay.Current.KeepScreenOn = false;
}
