<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Groot.App"
             xmlns:components="clr-namespace:Groot.App.Components"
             x:Class="Groot.App.MainPage"
             BackgroundColor="#1d2419">

    <!-- The web view paints white until the first frame of the page arrives, which showed as a
         flash between the splash and the boot mark. It starts on the boot background instead. -->
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html"
                   BackgroundColor="#1d2419">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
