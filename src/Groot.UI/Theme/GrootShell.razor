@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation
@implements IDisposable

@* The app shell: MudBlazor theme/dialog/snackbar providers, an app bar with a dark/light
   toggle, an optional side drawer, and the page body. Wraps its content in .theme-light /
   .theme-dark so the --g-* CSS tokens (see tokens.css) resolve everywhere beneath it. *@

<div class="@(_darkMode ? "theme-dark" : "theme-light") shell @(BottomNavDestinations is { Count: > 0 } ? "with-bottom-nav" : "")"
     style="@SafeAreaStyle">
    <MudThemeProvider Theme="GrootTheme.Theme" @bind-IsDarkMode="_darkMode" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />
    <MudLayout>
        <MudAppBar Elevation="0">
            @if (ShowDrawer)
            {
                <MudIconButton Icon="@(_drawerOpen ? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.Menu)"
                               Color="Color.Inherit" Edge="Edge.Start"
                               OnClick="@((e) => DrawerToggle())" />
            }
            @if (_appBar.Content is { } screenTitle)
            {
                @screenTitle
            }
            else
            {
                <MudText Typo="Typo.h6" Class="g-serif"><span>@Title</span>@Wordmark</MudText>
            }
            <MudSpacer />
            <MudIconButton Icon="@(_darkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
                           Color="Color.Inherit" OnClick="@((e) => ToggleTheme())" />
        </MudAppBar>

        @if (ShowDrawer)
        {
            <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always">
                @DrawerContent
            </MudDrawer>
        }

        <MudMainContent>
            @if (HostsScreenTitle)
            {
                <CascadingValue Value="_appBar" IsFixed="true">@ChildContent</CascadingValue>
            }
            else
            {
                @ChildContent
            }
        </MudMainContent>

        @if (BottomNavDestinations is { Count: > 0 })
        {
            <BottomNav Destinations="BottomNavDestinations"
                       Selected="SelectedDestination"
                       OnSelectedChanged="GoTo" />
        }
    </MudLayout>
</div>

@code {
    /// <summary>Brand shown in the app bar and drawer header.</summary>
    [Parameter] public string Title { get; set; } = "Groot";

    /// <summary>Show the side drawer (desktop web). Phone heads set this false.</summary>
    [Parameter] public bool ShowDrawer { get; set; }

    /// <summary>Nav content inside the drawer (a MudNavMenu), used only when ShowDrawer is true.</summary>
    [Parameter] public RenderFragment? DrawerContent { get; set; }

    /// <summary>
    /// Destinations for the phone nav along the bottom. Null or empty leaves it out, which is what
    /// the desktop web head does: it navigates from the drawer.
    /// </summary>
    [Parameter] public IReadOnlyList<GrootDestination>? BottomNavDestinations { get; set; }

    /// <summary>The page body supplied by the owning layout.</summary>
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// How many CSS pixels the status bar covers along the top. Null leaves the CSS reading
    /// env(safe-area-inset-top), which is what the browser heads and iOS use; Android's WebView
    /// reports zero there, so that head measures the bars and passes them in.
    /// </summary>
    [Parameter] public double? SafeAreaTop { get; set; }

    /// <summary>How many CSS pixels the gesture bar or the button bar covers along the bottom.</summary>
    [Parameter] public double? SafeAreaBottom { get; set; }

    /// <summary>
    /// Let the open screen put its own heading in the app bar, instead of carrying one inside the
    /// page. The product heads do; the gallery does not, because it shows many screens at once and
    /// each of them has to keep its own heading where it is.
    /// </summary>
    [Parameter] public bool HostsScreenTitle { get; set; }

    /// <summary>
    /// The wordmark's amber full stop, left out when the head's own title already carries
    /// punctuation (the gallery calls itself Groot.UI).
    /// </summary>
    private RenderFragment? Wordmark => Title.Contains('.') ? null : @<span class="accent">.</span>;

    private readonly GrootAppBar _appBar = new();
    private bool _drawerOpen = true;
    private bool _darkMode = true;

    protected override void OnInitialized()
    {
        _appBar.Changed += OnAppBarChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnAppBarChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// The bar goes back to the brand on every move, and the screen that arrives puts its own
    /// heading back. Without this a screen that stays mounted behind another one (the phone head
    /// keeps a run alive that way) would leave its heading in the bar of the screen you moved to.
    /// </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _appBar.Set(null);

    public void Dispose()
    {
        _appBar.Changed -= OnAppBarChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    /// <summary>Which tab reads as current, taken from the address rather than held separately.</summary>
    private GrootDestination SelectedDestination => Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/') switch
    {
        "run" => GrootDestination.Run,
        "lift" => GrootDestination.Lift,
        "progress" => GrootDestination.Progress,
        _ => GrootDestination.Home,
    };

    private void GoTo(GrootDestination destination) => Navigation.NavigateTo(destination switch
    {
        GrootDestination.Run => "/run",
        GrootDestination.Lift => "/lift",
        GrootDestination.Progress => "/progress",
        _ => "/",
    });

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private void ToggleTheme() => _darkMode = !_darkMode;

    /// <summary>The measured insets, when the head has them, as the two variables the CSS reads.</summary>
    private string? SafeAreaStyle => SafeAreaTop is null && SafeAreaBottom is null
        ? null
        : FormattableString.Invariant(
            $"--g-safe-top: {SafeAreaTop ?? 0}px; --g-safe-bottom: {SafeAreaBottom ?? 0}px");
}
