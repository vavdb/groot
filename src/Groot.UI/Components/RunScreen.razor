@* The 0→5K runner screen: drives the interval clock and cue playback. The flood panel and
   segment bar are custom colour-state visuals (see RunFlood/SegmentBar); the rest is MudBlazor.
   Interval maths comes from Groot.Core's RunSession. *@
@using System.Diagnostics
@using Groot.Core.Health
@using Groot.Core.Intervals
@using Groot.UI.Theme
@using Groot.UI.Audio
@using Groot.UI.Health
@implements IDisposable

<section class="run-screen" aria-label="@Heading">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="run-head">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.h6" Class="g-serif">
                    @ProgramName <MudText Typo="Typo.caption" Inline="true" Class="dim">@SessionLabel</MudText>
                </MudText>
                @HeaderAction
            </MudStack>
            <div class="dots" role="img" aria-label="Session @Day of @SessionsInWeek this week">
                @for (var d = 1; d <= SessionsInWeek; d++)
                {
                    <i class="@(d < Day ? "done" : d == Day ? "now" : "")"></i>
                }
            </div>
        </MudStack>

        @ChildContent

        <RunFlood StateLabel="@StateLabel"
                  TimeText="@Clock(_finished ? 0 : Progress.RemainingInSegment)"
                  NextLine="@NextLine"
                  FloodClass="@FloodClass" />

        <div class="cue" aria-live="polite">
            <span class="spk" aria-hidden="true">@(_cuePlayer is null or SilentCuePlayer ? "🔇" : "🔊")</span>
            <span class="cue-text">@(_lastCueText ?? "Cues speak at every switch and ten seconds before it.")</span>
        </div>

        @* The trace and the bar are one object: both are drawn from Session.Segments at the same
           proportional widths, so a run block starts at the same x in each. Keep them adjacent. *@
        <div class="measured">
            @if (ShowHeartRate)
            {
                <HeartRateTrace Trace="_primary.View()"
                                Second="@(_secondary?.View())"
                                Segments="Session.Segments"
                                ElapsedSeconds="@(_started ? ElapsedSeconds : 0)"
                                MaximumBpm="MaximumBpm" />
            }

            <SegmentBar Segments="Session.Segments"
                        SegmentIndex="Progress.SegmentIndex"
                        Started="@_started"
                        Finished="@_finished" />
        </div>

        @if (ShowRoute)
        {
            <RouteMap Route="_route.View()" Segments="Session.Segments" MaximumBpm="MaximumBpm" />
        }

        <GrootStats>
            <GrootStat Label="elapsed" Value="@Clock(Progress.ElapsedTotal)" />
            <GrootStat Label="segment" Value="@($"{Progress.SegmentIndex + 1}/{Session.Segments.Count}")" />
            <GrootStat Label="total" Value="@Clock(Session.TotalSeconds)" />
        </GrootStats>

        @if (_finished)
        {
            <GrootPanel Filled="true" Class="summary">
                <MudText Typo="Typo.h5" Class="g-serif big">Done · @Clock(Session.TotalSeconds)</MudText>
                <MudText Typo="Typo.caption" Class="subt">@Session.RunCount run blocks · @Clock(Session.RunSeconds) running · @SessionLabel</MudText>
            </GrootPanel>
        }

        @if (HeartRate?.IsSupported == true || Location?.IsSupported == true)
        {
            <SourceChips Devices="@(HeartRate?.Devices ?? [])"
                         HeartRateEnabled="ShowHeartRate"
                         LocationEnabled="ShowRoute"
                         LocationState="@(Location?.State ?? SensorState.Off)"
                         DistanceKm="_route.DistanceMetres / 1000"
                         HeartRateTrouble="@(HeartRate?.Trouble)"
                         LocationTrouble="@(Location?.Trouble)"
                         OnRetry="RetryAsync" />
        }

        <MudStack Row="true" Spacing="2">
            @if (_finished)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="StartAsync">↻ Run it again</MudButton>
            }
            else if (!_started)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="StartAsync">Start ▶</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" OnClick="TogglePause">@(_running ? "⏸ Pause" : "▶ Resume")</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="SkipAsync">⏭ Skip</MudButton>
            }
        </MudStack>
    </MudStack>
</section>

@code {
    private const int TickMilliseconds = 250;

    /// <summary>How often the source chips refresh while the session is not running.</summary>
    private const int ChipTickMilliseconds = 1000;

    /// <summary>
    /// The session being run. Replacing the instance (a new program/week/day) requires an
    /// <c>@key</c> on this component so Blazor tears down and rebuilds the timer state instead
    /// of reusing it against the new session's segments — both heads already key it.
    /// </summary>
    [Parameter, EditorRequired] public RunSession Session { get; set; } = null!;

    /// <summary>A control beside the session dots, for whatever the owner puts there (the session pencil).</summary>
    [Parameter] public RenderFragment? HeaderAction { get; set; }

    /// <summary>Content directly under the header, above the clock. The owner's session editor lives here.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Where cues are spoken. Null keeps the screen silent but fully usable.</summary>
    [Parameter] public ICuePlayer? CuePlayer { get; set; }

    [Parameter] public string Language { get; set; } = RunCueText.DefaultLanguage;

    [Parameter] public int SessionsInWeek { get; set; } = 3;

    [Parameter] public EventCallback OnFinished { get; set; }

    /// <summary>
    /// The heart rate monitors, if this head has any. Null, or a service that is not supported,
    /// and the screen is exactly what it was before: no trace, no chips.
    /// </summary>
    [Parameter] public IHeartRateService? HeartRate { get; set; }

    /// <summary>Where the phone is, if this head can tell. Null leaves the route off.</summary>
    [Parameter] public ILocationService? Location { get; set; }

    /// <summary>The runner's highest heart rate, which sets where the zone boundaries fall.</summary>
    [Parameter] public int MaximumBpm { get; set; } = HeartRateZones.DefaultMaximumBpm;

    /// <summary>
    /// Raised when a session finishes, with everything that was measured during it. The owner
    /// stores it; the screen does not know what a database is.
    /// </summary>
    [Parameter] public EventCallback<MeasuredRun> OnMeasured { get; set; }

    private ICuePlayer? _cuePlayer;
    private CancellationTokenSource? _loop;
    private CancellationTokenSource? _chipLoop;

    // One recorder per monitor, keyed by device id, plus the route. Built when the session
    // starts, because the trace's bucket count depends on how long the session is.
    private readonly Dictionary<string, MonitorRecording> _heartRates = [];
    private RouteTrack _route = new();
    private long _lastFixSequence = -1;

    private HeartRateTrack _primary = new(1);
    private HeartRateTrack? _secondary;

    /// <summary>
    /// What one monitor produced: the bucketed track the trace draws, and every reading as it
    /// arrived. The two are not the same thing. The track holds about fifty buckets however long
    /// the session is, which is the right amount to draw and far too little to keep: an export
    /// to Health Connect or to a GPX file wants the readings themselves, roughly one a second.
    /// </summary>
    private sealed class MonitorRecording(int totalSeconds)
    {
        private int _lastLoggedSecond = -1;

        public HeartRateTrack Track { get; } = new(totalSeconds);

        public List<HeartRateSample> Samples { get; } = [];

        /// <summary>
        /// Records a reading. The screen polls four times a second and a monitor reports about
        /// once, so only the first reading of each second is kept: without that the log is three
        /// quarters repeats, and the store would collapse them on the way in anyway.
        /// </summary>
        public void Add(int elapsedSeconds, int bpm)
        {
            Track.Add(elapsedSeconds, bpm);

            if (elapsedSeconds == _lastLoggedSecond) return;

            _lastLoggedSecond = elapsedSeconds;
            Samples.Add(new HeartRateSample(elapsedSeconds, bpm));
        }
    }

    // Monotonic clock (Stopwatch.GetTimestamp), not DateTimeOffset.UtcNow — the wall clock can
    // jump backwards (NTP adjustment) and truncating to whole seconds at every pause loses up
    // to ~1s per pause/resume. We accumulate milliseconds continuously and only round to a
    // second at the display/cue boundary.
    private long _elapsedMs;
    private long _resumeTimestamp;
    private int _lastCueSecond = -1;
    private bool _started;
    private bool _running;
    private bool _finished;
    private string? _lastCueText;

    protected override void OnParametersSet()
    {
        // Segment durations are validated in RunSession's constructor; a session here is always playable.
        _cuePlayer = CuePlayer;
    }

    /// <summary>
    /// The radios come on when the screen opens, not when Start is pressed. A watch takes tens
    /// of seconds to be found and a first GPS fix can take a minute, so waiting for Start meant
    /// the chip read "looking for a monitor" while nothing was looking, and the first minute of
    /// every run went unmeasured.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await StartSensorsAsync();
        StartChipLoop();
    }

    /// <summary>
    /// Keeps the chips honest while the session is not running. The session's own loop redraws
    /// four times a second, but before Start and while paused nothing else would, and a chip that
    /// never changes is what "stuck on looking for a monitor" looked like.
    /// </summary>
    private void StartChipLoop()
    {
        var cts = new CancellationTokenSource();
        _chipLoop = cts;
        _ = ChipLoopAsync(cts.Token);
    }

    private async Task ChipLoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(ChipTickMilliseconds));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                // Only when the session loop is not already redrawing, so the two never fight.
                if (!_running) await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The screen went away.
        }
        catch (ObjectDisposedException)
        {
            // Cancelled and disposed between ticks.
        }
    }

    /// <summary>Whether there is a heart rate strip to draw: a supported service, switched on.</summary>
    private bool ShowHeartRate => HeartRate is { IsSupported: true } && _heartRateOn;

    /// <summary>Whether there is a route to draw.</summary>
    private bool ShowRoute => Location is { IsSupported: true } && _routeOn;

    // Both default on where the head supports them: someone who put a watch on and pressed start
    // wants the reading, and the chips are there to turn either back off.
    private bool _heartRateOn = true;
    private bool _routeOn = true;

    private long CurrentElapsedMs => _running ? _elapsedMs + MsSince(_resumeTimestamp) : _elapsedMs;

    private static long MsSince(long stopwatchTimestamp) =>
        (long)((Stopwatch.GetTimestamp() - stopwatchTimestamp) * 1000.0 / Stopwatch.Frequency);

    private int ElapsedSeconds => Math.Clamp((int)(CurrentElapsedMs / 1000), 0, Session.TotalSeconds);

    private RunProgress Progress => Session.ProgressAt(_started ? ElapsedSeconds : 0);

    private string ProgramName => Session.Id?.ProgramName ?? "Interval session";

    private int Day => Session.Id?.Day ?? 1;

    private string SessionLabel => Session.Id is { } id ? $"W{id.Week} · D{id.Day}" : "session";

    private string Heading => $"{ProgramName} {SessionLabel}";

    private string StateLabel => _finished
        ? "DONE"
        : !_started ? "READY" : Progress.Segment.Kind == SegmentKind.Run ? "RUN" : "WALK";

    private string FloodClass =>
        (_finished ? "done" : Progress.Segment.Kind == SegmentKind.Run ? "run" : "walk")
        + (_started && !_running && !_finished ? " paused" : "");

    private string NextLine
    {
        get
        {
            if (_finished) return "session complete";
            if (!_started) return $"first up · {Label(Progress.Segment)} {Clock(Progress.Segment.Seconds)}";
            return Progress.NextSegment is { } next
                ? $"then · {Label(next)} {Clock(next.Seconds)}"
                : "then · finish";
        }
    }

    private static string Label(Segment segment) => segment.Label ?? (segment.Kind == SegmentKind.Run ? "run" : "walk");

    private static string Clock(int seconds) => GrootFormat.Clock(seconds);

    private async Task StartAsync()
    {
        StopLoop();
        _elapsedMs = 0;
        _lastCueSecond = -1;
        _lastCueText = null;
        _finished = false;
        _started = true;
        _running = true;
        _resumeTimestamp = Stopwatch.GetTimestamp();

        ResetMeasurements();
        await StartSensorsAsync();

        var cts = new CancellationTokenSource();
        _loop = cts;
        var token = cts.Token; // captured before the await — cts may be disposed by a concurrent StopLoop while we're suspended
        await TickAsync();
        if (ReferenceEquals(_loop, cts)) // still the current session (not disposed/replaced during the await)
            _ = LoopAsync(token);
    }

    private void TogglePause()
    {
        if (_finished) return;

        if (_running)
        {
            _elapsedMs += MsSince(_resumeTimestamp);
            _running = false;
        }
        else
        {
            _resumeTimestamp = Stopwatch.GetTimestamp();
            _running = true;
        }
    }

    private async Task SkipAsync()
    {
        if (_finished) return;

        var targetSeconds = Session.SkipTargetFrom(ElapsedSeconds);
        _elapsedMs = targetSeconds * 1000L;
        _resumeTimestamp = Stopwatch.GetTimestamp();
        _lastCueSecond = targetSeconds - 1; // skipped cues are gone; the new segment still announces itself
        await TickAsync();
    }

    private async Task LoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(TickMilliseconds));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await TickAsync();
                if (_finished) return;
            }
        }
        catch (OperationCanceledException)
        {
            // screen disposed or session restarted
        }
        catch (ObjectDisposedException)
        {
            // StopLoop cancelled and disposed the token source while this loop was between ticks
        }
    }

    private async Task TickAsync()
    {
        var elapsed = ElapsedSeconds;

        // While paused nothing moves; only a skip can push elapsed past the last cue second.
        if (!_running && elapsed <= _lastCueSecond) return;

        Sample(elapsed);

        if (_running || elapsed > _lastCueSecond)
        {
            foreach (var cue in Session.CuesBetween(_lastCueSecond, elapsed))
                await PlayAsync(cue);
            _lastCueSecond = Math.Max(_lastCueSecond, elapsed);
        }

        if (elapsed >= Session.TotalSeconds && !_finished)
        {
            _finished = true;
            _running = false;
            _elapsedMs = Session.TotalSeconds * 1000L;
            StopLoop();
            await StopSensorsAsync();
            await OnMeasured.InvokeAsync(new MeasuredRun(Session.Id, Session.TotalSeconds, Measured()));
            await OnFinished.InvokeAsync();
        }

        StateHasChanged();
    }

    private async Task PlayAsync(RunCue cue)
    {
        _lastCueText = RunCueText.Speak(cue, Language);
        if (_cuePlayer is null) return;

        try
        {
            await _cuePlayer.PlayAsync(SoundFor(cue));
            await _cuePlayer.SpeakAsync(_lastCueText);
        }
        catch
        {
            // A broken or missing cue player must never stall the session.
        }
    }

    private static CueSound SoundFor(RunCue cue) => cue switch
    {
        { CueKind: RunCueKind.Finished } => CueSound.Finish,
        { CueKind: RunCueKind.SegmentStart, Kind: SegmentKind.Run } => CueSound.RunStart,
        { CueKind: RunCueKind.SegmentStart } => CueSound.WalkStart,
        _ => CueSound.Warning,
    };

    // ---- what the session measured -------------------------------------------------------

    private void ResetMeasurements()
    {
        _heartRates.Clear();
        _route = new RouteTrack();
        _lastFixSequence = -1;
        _primary = new HeartRateTrack(Session.TotalSeconds);
        _secondary = null;
    }

    /// <summary>
    /// A chip was tapped. Off, and it switches that source on for this session; on, and it asks
    /// the service to try again, which is what a monitor that has just had its broadcast toggle
    /// turned on needs.
    /// </summary>
    private async Task RetryAsync(SourceChips.SourceKind kind)
    {
        switch (kind)
        {
            case SourceChips.SourceKind.HeartRate when HeartRate is { IsSupported: true }:
                // Off, and the tap switches it on. On, and the tap is a retry, which is what a
                // watch that has only just had its broadcast toggle turned on needs. Reading the
                // state to decide would make the tap a no-op in exactly that case.
                if (_heartRateOn && HeartRate.State is SensorState.Live)
                {
                    _heartRateOn = false;
                    await Try(HeartRate.StopAsync);
                }
                else
                {
                    // Stop first: StartAsync is idempotent, so without this a retry on a service
                    // that is already listening and deaf would do nothing at all.
                    _heartRateOn = true;
                    await Try(HeartRate.StopAsync);
                    await Try(() => HeartRate.StartAsync());
                }

                break;

            case SourceChips.SourceKind.Location when Location is { IsSupported: true }:
                if (_routeOn && Location.State is SensorState.Live)
                {
                    _routeOn = false;
                    await Try(Location.StopAsync);
                }
                else
                {
                    _routeOn = true;
                    await Try(Location.StopAsync);
                    await Try(() => Location.StartAsync());
                }

                break;
        }
    }

    private async Task StartSensorsAsync()
    {
        // A sensor that will not start must never stop a run. The chips say what happened.
        if (ShowHeartRate) await Try(() => HeartRate!.StartAsync());
        if (ShowRoute) await Try(() => Location!.StartAsync());
    }

    private async Task StopSensorsAsync()
    {
        if (HeartRate is not null) await Try(HeartRate.StopAsync);
        if (Location is not null) await Try(Location.StopAsync);
    }

    private static async Task Try(Func<Task> work)
    {
        try
        {
            await work();
        }
        catch
        {
            // A radio that refuses to start, or to stop, is not a reason to lose the session.
        }
    }

    /// <summary>
    /// Reads whatever the sensors are holding and stamps it with the session's own clock.
    /// <para>
    /// Polled here rather than pushed from an event: a monitor reports about once a second and
    /// this already runs four times a second, so nothing is missed, every reading lands on the
    /// render thread without marshalling, and a reading that arrives while the session is paused
    /// is simply never taken — which is what a paused session means.
    /// </para>
    /// </summary>
    private void Sample(int elapsedSeconds)
    {
        var bpm = default(int?);

        if (ShowHeartRate)
        {
            foreach (var device in HeartRate!.Devices)
            {
                if (device is not { State: SensorState.Live, Bpm: { } reading }) continue;

                if (!_heartRates.TryGetValue(device.Id, out var recording))
                {
                    recording = new MonitorRecording(Session.TotalSeconds);
                    _heartRates[device.Id] = recording;
                }

                recording.Add(elapsedSeconds, reading);
            }

            // The first monitor to report anything is the one whose number the screen shows and
            // whose line is drawn solid. Whichever connected first, not whichever sorts first.
            _primary = _heartRates.Values.FirstOrDefault()?.Track ?? _primary;
            _secondary = _heartRates.Values.Skip(1).FirstOrDefault()?.Track;
            bpm = _primary.Current;
        }

        if (ShowRoute && Location!.Latest is { } fix && fix.Sequence != _lastFixSequence)
        {
            _lastFixSequence = fix.Sequence;
            _route.Add(new RouteFix(elapsedSeconds, fix.Latitude, fix.Longitude, fix.AccuracyMetres, bpm));
        }
    }

    /// <summary>Everything the session measured, for the owner to store.</summary>
    private MeasuredSession Measured() => new(
        _heartRates.ToDictionary(
            pair => pair.Key,
            pair => (IReadOnlyList<HeartRateSample>)pair.Value.Samples),
        _route.Fixes,
        _route.DistanceMetres);

    private void StopLoop()
    {
        _loop?.Cancel();
        _loop?.Dispose();
        _loop = null;
    }

    public void Dispose()
    {
        StopLoop();
        _chipLoop?.Cancel();
        _chipLoop?.Dispose();
        _chipLoop = null;

        // Leaving the screen must release the radios, or a GPS the size of a session keeps
        // running after the session is gone. Fire and forget: Dispose cannot await, and neither
        // service throws out of Stop.
        _ = StopSensorsAsync();
    }
}
