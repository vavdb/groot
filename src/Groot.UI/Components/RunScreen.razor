@* The 0→5K runner screen: drives the interval clock and cue playback. The flood panel and
   segment bar are custom colour-state visuals (see RunFlood/SegmentBar); the rest is MudBlazor.
   Interval maths comes from Groot.Core's RunSession. *@
@using System.Diagnostics
@using Groot.Core.Intervals
@using Groot.UI.Theme
@using Groot.UI.Audio
@implements IDisposable

<section class="run-screen" aria-label="@Heading">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="run-head">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.h6" Class="g-serif">
                    @ProgramName <MudText Typo="Typo.caption" Inline="true" Class="dim">@SessionLabel</MudText>
                </MudText>
                @HeaderAction
            </MudStack>
            <div class="dots" role="img" aria-label="Session @Day of @SessionsInWeek this week">
                @for (var d = 1; d <= SessionsInWeek; d++)
                {
                    <i class="@(d < Day ? "done" : d == Day ? "now" : "")"></i>
                }
            </div>
        </MudStack>

        @ChildContent

        <RunFlood StateLabel="@StateLabel"
                  TimeText="@Clock(_finished ? 0 : Progress.RemainingInSegment)"
                  NextLine="@NextLine"
                  FloodClass="@FloodClass" />

        <div class="cue" aria-live="polite">
            <span class="spk" aria-hidden="true">@(_cuePlayer is null or SilentCuePlayer ? "🔇" : "🔊")</span>
            <span class="cue-text">@(_lastCueText ?? "Cues speak at every switch and ten seconds before it.")</span>
        </div>

        <SegmentBar Segments="Session.Segments"
                    SegmentIndex="Progress.SegmentIndex"
                    Started="@_started"
                    Finished="@_finished" />

        <GrootStats>
            <GrootStat Label="elapsed" Value="@Clock(Progress.ElapsedTotal)" />
            <GrootStat Label="segment" Value="@($"{Progress.SegmentIndex + 1}/{Session.Segments.Count}")" />
            <GrootStat Label="total" Value="@Clock(Session.TotalSeconds)" />
        </GrootStats>

        @if (_finished)
        {
            <GrootPanel Filled="true" Class="summary">
                <MudText Typo="Typo.h5" Class="g-serif big">Done · @Clock(Session.TotalSeconds)</MudText>
                <MudText Typo="Typo.caption" Class="subt">@Session.RunCount run blocks · @Clock(Session.RunSeconds) running · @SessionLabel</MudText>
            </GrootPanel>
        }

        <MudStack Row="true" Spacing="2">
            @if (_finished)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="StartAsync">↻ Run it again</MudButton>
            }
            else if (!_started)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="StartAsync">Start ▶</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" OnClick="TogglePause">@(_running ? "⏸ Pause" : "▶ Resume")</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="SkipAsync">⏭ Skip</MudButton>
            }
        </MudStack>
    </MudStack>
</section>

@code {
    private const int TickMilliseconds = 250;

    /// <summary>
    /// The session being run. Replacing the instance (a new program/week/day) requires an
    /// <c>@key</c> on this component so Blazor tears down and rebuilds the timer state instead
    /// of reusing it against the new session's segments — both heads already key it.
    /// </summary>
    [Parameter, EditorRequired] public RunSession Session { get; set; } = null!;

    /// <summary>A control beside the session dots, for whatever the owner puts there (the session pencil).</summary>
    [Parameter] public RenderFragment? HeaderAction { get; set; }

    /// <summary>Content directly under the header, above the clock. The owner's session editor lives here.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Where cues are spoken. Null keeps the screen silent but fully usable.</summary>
    [Parameter] public ICuePlayer? CuePlayer { get; set; }

    [Parameter] public string Language { get; set; } = RunCueText.DefaultLanguage;

    [Parameter] public int SessionsInWeek { get; set; } = 3;

    [Parameter] public EventCallback OnFinished { get; set; }

    private ICuePlayer? _cuePlayer;
    private CancellationTokenSource? _loop;

    // Monotonic clock (Stopwatch.GetTimestamp), not DateTimeOffset.UtcNow — the wall clock can
    // jump backwards (NTP adjustment) and truncating to whole seconds at every pause loses up
    // to ~1s per pause/resume. We accumulate milliseconds continuously and only round to a
    // second at the display/cue boundary.
    private long _elapsedMs;
    private long _resumeTimestamp;
    private int _lastCueSecond = -1;
    private bool _started;
    private bool _running;
    private bool _finished;
    private string? _lastCueText;

    protected override void OnParametersSet()
    {
        // Segment durations are validated in RunSession's constructor; a session here is always playable.
        _cuePlayer = CuePlayer;
    }

    private long CurrentElapsedMs => _running ? _elapsedMs + MsSince(_resumeTimestamp) : _elapsedMs;

    private static long MsSince(long stopwatchTimestamp) =>
        (long)((Stopwatch.GetTimestamp() - stopwatchTimestamp) * 1000.0 / Stopwatch.Frequency);

    private int ElapsedSeconds => Math.Clamp((int)(CurrentElapsedMs / 1000), 0, Session.TotalSeconds);

    private RunProgress Progress => Session.ProgressAt(_started ? ElapsedSeconds : 0);

    private string ProgramName => Session.Id?.ProgramName ?? "Interval session";

    private int Day => Session.Id?.Day ?? 1;

    private string SessionLabel => Session.Id is { } id ? $"W{id.Week} · D{id.Day}" : "session";

    private string Heading => $"{ProgramName} {SessionLabel}";

    private string StateLabel => _finished
        ? "DONE"
        : !_started ? "READY" : Progress.Segment.Kind == SegmentKind.Run ? "RUN" : "WALK";

    private string FloodClass =>
        (_finished ? "done" : Progress.Segment.Kind == SegmentKind.Run ? "run" : "walk")
        + (_started && !_running && !_finished ? " paused" : "");

    private string NextLine
    {
        get
        {
            if (_finished) return "session complete";
            if (!_started) return $"first up · {Label(Progress.Segment)} {Clock(Progress.Segment.Seconds)}";
            return Progress.NextSegment is { } next
                ? $"then · {Label(next)} {Clock(next.Seconds)}"
                : "then · finish";
        }
    }

    private static string Label(Segment segment) => segment.Label ?? (segment.Kind == SegmentKind.Run ? "run" : "walk");

    private static string Clock(int seconds) => GrootFormat.Clock(seconds);

    private async Task StartAsync()
    {
        StopLoop();
        _elapsedMs = 0;
        _lastCueSecond = -1;
        _lastCueText = null;
        _finished = false;
        _started = true;
        _running = true;
        _resumeTimestamp = Stopwatch.GetTimestamp();

        var cts = new CancellationTokenSource();
        _loop = cts;
        var token = cts.Token; // captured before the await — cts may be disposed by a concurrent StopLoop while we're suspended
        await TickAsync();
        if (ReferenceEquals(_loop, cts)) // still the current session (not disposed/replaced during the await)
            _ = LoopAsync(token);
    }

    private void TogglePause()
    {
        if (_finished) return;

        if (_running)
        {
            _elapsedMs += MsSince(_resumeTimestamp);
            _running = false;
        }
        else
        {
            _resumeTimestamp = Stopwatch.GetTimestamp();
            _running = true;
        }
    }

    private async Task SkipAsync()
    {
        if (_finished) return;

        var targetSeconds = Session.SkipTargetFrom(ElapsedSeconds);
        _elapsedMs = targetSeconds * 1000L;
        _resumeTimestamp = Stopwatch.GetTimestamp();
        _lastCueSecond = targetSeconds - 1; // skipped cues are gone; the new segment still announces itself
        await TickAsync();
    }

    private async Task LoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(TickMilliseconds));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await TickAsync();
                if (_finished) return;
            }
        }
        catch (OperationCanceledException)
        {
            // screen disposed or session restarted
        }
        catch (ObjectDisposedException)
        {
            // StopLoop cancelled and disposed the token source while this loop was between ticks
        }
    }

    private async Task TickAsync()
    {
        var elapsed = ElapsedSeconds;

        // While paused nothing moves; only a skip can push elapsed past the last cue second.
        if (!_running && elapsed <= _lastCueSecond) return;

        if (_running || elapsed > _lastCueSecond)
        {
            foreach (var cue in Session.CuesBetween(_lastCueSecond, elapsed))
                await PlayAsync(cue);
            _lastCueSecond = Math.Max(_lastCueSecond, elapsed);
        }

        if (elapsed >= Session.TotalSeconds && !_finished)
        {
            _finished = true;
            _running = false;
            _elapsedMs = Session.TotalSeconds * 1000L;
            StopLoop();
            await OnFinished.InvokeAsync();
        }

        StateHasChanged();
    }

    private async Task PlayAsync(RunCue cue)
    {
        _lastCueText = RunCueText.Speak(cue, Language);
        if (_cuePlayer is null) return;

        try
        {
            await _cuePlayer.PlayAsync(SoundFor(cue));
            await _cuePlayer.SpeakAsync(_lastCueText);
        }
        catch
        {
            // A broken or missing cue player must never stall the session.
        }
    }

    private static CueSound SoundFor(RunCue cue) => cue switch
    {
        { CueKind: RunCueKind.Finished } => CueSound.Finish,
        { CueKind: RunCueKind.SegmentStart, Kind: SegmentKind.Run } => CueSound.RunStart,
        { CueKind: RunCueKind.SegmentStart } => CueSound.WalkStart,
        _ => CueSound.Warning,
    };

    private void StopLoop()
    {
        _loop?.Cancel();
        _loop?.Dispose();
        _loop = null;
    }

    public void Dispose() => StopLoop();
}
