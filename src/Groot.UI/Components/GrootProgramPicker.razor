@* The three interval controls: program, week, session. Controlled, not stateful: it renders the
   values it is given and raises the change. The selection lives with the owner because this sits
   inside the keyed run panel, and a component that resets itself on its own change is no use. *@
@using Groot.Core.Intervals
@using Groot.Core.Programs

@if (ShowControls)
{
    <MudStack Spacing="2" Class="picker-controls">
        @if (ShowProgram)
        {
            <GrootChoice T="string" Label="Program" Items="ProgramIds" Value="ProgramId"
                         Display="@(id => Programs.First(p => p.Id == id).Name)"
                         ValueChanged="ProgramIdChanged" />
        }

        <GrootChoice T="int" Label="Week" Items="Program.WeekNumbers" Value="Week"
                     Display="@(week => $"Week {week}")" ValueChanged="WeekChanged" />

        <GrootChoice T="int" Label="Session" Items="RunSession.DaysOf(Program, Week)" Value="Day"
                     Display="@(day => $"Day {day}")" ValueChanged="DayChanged" />

        @ChildContent
    </MudStack>
}

@code {
    /// <summary>Interval programs to offer.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<IntervalProgram> Programs { get; set; } = [];

    /// <summary>Show the program selector (false for a single fixed program).</summary>
    [Parameter] public bool ShowProgram { get; set; } = true;

    /// <summary>Render the controls at all.</summary>
    [Parameter] public bool ShowControls { get; set; } = true;

    /// <summary>Extra controls under the selects, for whatever else the owner edits here.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter, EditorRequired] public string ProgramId { get; set; } = "";
    [Parameter] public EventCallback<string> ProgramIdChanged { get; set; }

    [Parameter] public int Week { get; set; }
    [Parameter] public EventCallback<int> WeekChanged { get; set; }

    [Parameter] public int Day { get; set; }
    [Parameter] public EventCallback<int> DayChanged { get; set; }

    private IReadOnlyList<string> ProgramIds => Programs.Select(p => p.Id).ToArray();

    private IntervalProgram Program =>
        Programs.FirstOrDefault(p => p.Id == ProgramId) ?? Programs[0];
}
