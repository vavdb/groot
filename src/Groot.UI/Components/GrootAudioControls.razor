@* Voice-language and sound-cue switches for the run screen. The head feeds the current
   values back and reacts via callbacks (Web drives Web Speech; phone heads omit this). *@

<MudStack Spacing="3">
    <GrootChoice T="string" Label="Voice" Items="Languages" Value="Language"
                 Display="@(code => code == Dutch ? "Nederlands" : "English")"
                 ValueChanged="OnLanguageChanged" />

    <MudSwitch T="bool" Label="Sound cues" Color="Color.Primary" @bind-Value="Sound"
               @bind-Value:after="RaiseChanged" />
</MudStack>

@code {
    private const string English = "en";
    private const string Dutch = "nl";

    private static readonly string[] Languages = [English, Dutch];

    [Parameter] public string Language { get; set; } = English;
    [Parameter] public EventCallback<string> LanguageChanged { get; set; }
    [Parameter] public bool Sound { get; set; } = true;
    [Parameter] public EventCallback<bool> SoundChanged { get; set; }

    /// <summary>Fires after either value changes, once both @bind-* callbacks above have run.</summary>
    [Parameter] public EventCallback ValuesChanged { get; set; }

    private async Task OnLanguageChanged(string language)
    {
        Language = language;
        await RaiseChanged();
    }

    private async Task RaiseChanged()
    {
        await LanguageChanged.InvokeAsync(Language);
        await SoundChanged.InvokeAsync(Sound);
        await ValuesChanged.InvokeAsync();
    }
}
