@* The weekly contract card: seven day-slot cells, a lift/run/rest meter, and joker count.
   Meter values come from Core's ContractEvaluator; jokers render as filled/hollow diamonds. *@
@using Groot.Core.Contract

<GrootPanel Title="@Title" Meta="@StreakLine" Class="week-card">
    <HeaderContent>
        <MudText Typo="Typo.overline" Class="jokers">@JokerDisplay</MudText>
    </HeaderContent>
    <ChildContent>
        <MudStack Spacing="3">
            <DaySlots Days="Days" />

            @if (Evaluation is { } eval)
            {
                <MudDivider />
                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="meter">
                    <MudText Typo="Typo.caption">LIFT <b class="@(eval.LiftCredits + eval.JokersSpent >= Contract.Lifts ? "ok" : "")">@eval.LiftCredits/@Contract.Lifts</b></MudText>
                    <MudText Typo="Typo.caption">RUN <b class="@(eval.RunCredits >= Contract.Runs ? "ok" : "")">@eval.RunCredits/@Contract.Runs</b></MudText>
                    <MudText Typo="Typo.caption">REST <b>@(eval.RestKept ? "✓" : "—")</b></MudText>
                    <MudText Typo="Typo.caption" Class="@(JokersLeft == 0 ? "warn" : "")">◆ @JokersLeft left</MudText>
                </MudStack>
            }
        </MudStack>
    </ChildContent>
</GrootPanel>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<DaySlot> Days { get; set; } = [];
    [Parameter] public WeekEvaluation? Evaluation { get; set; }
    [Parameter] public WeekContract Contract { get; set; } = new();
    // Short on purpose: the meter below spells the contract out (LIFT 1/2, RUN 2/2, REST), and at
    // phone width a long title pushed the streak onto its own line.
    [Parameter] public string Title { get; set; } = "This week";

    /// <summary>
    /// Consecutive kept weeks, counted by <see cref="ContractEvaluator.StreakWeeks"/> from the
    /// head's history. Zero says nothing rather than saying zero.
    /// </summary>
    [Parameter] public int Streak { get; set; }

    private int JokersLeft => Contract.Jokers - (Evaluation?.JokersSpent ?? 0);

    private string? StreakLine => Streak switch
    {
        <= 0 => null,
        1 => "1 week kept",
        _ => $"{Streak} weeks kept",
    };

    private string JokerDisplay =>
        string.Concat(Enumerable.Repeat("◆", Math.Max(0, JokersLeft)))
        + string.Concat(Enumerable.Repeat("◇", Evaluation?.JokersSpent ?? 0));
}
