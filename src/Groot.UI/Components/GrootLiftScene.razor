@* The lifting screen and the day picker behind its pencil, the same shape the run screen has.
   Working weights stand in until there is a store: the head can pass its own, and the defaults
   here are a plain starting table, not a recommendation. *@
@using Groot.Core.Programs
@using Groot.Core.Sessions

<div class="lift-scene">
    <LiftScreen @key="_dayKey" Plan="_plan" Program="Program">
        <HeaderAction>
            <MudIconButton Icon="@(_editing ? Icons.Material.Filled.Check : Icons.Material.Filled.Edit)"
                           Size="Size.Small"
                           aria-label="@(_editing ? "Done choosing day" : "Change day")"
                           OnClick="ToggleEditing" />
        </HeaderAction>
        <ChildContent>
            @if (_editing)
            {
                <GrootChoice T="string" Label="Day" Items="Program.Rotation" Value="_dayKey"
                             Display="@(key => $"{key} · {Summary(key)}")"
                             ValueChanged="OnDayChanged" />
            }
        </ChildContent>
    </LiftScreen>
</div>

@code {
    /// <summary>The program to train. Defaults to the one program in the catalog that has days.</summary>
    [Parameter] public LiftProgram Program { get; set; } = ProgramCatalog.Embedded.LiftPrograms[0];

    /// <summary>Where each lift stands, per exercise and tier. Missing slots show as bodyweight.</summary>
    [Parameter] public IReadOnlyDictionary<ExerciseSlot, ExerciseState> ExerciseStates { get; set; } = StarterWeights;

    /// <summary>Which day of the rotation to open on.</summary>
    [Parameter] public string? DayKey { get; set; }

    /// <summary>
    /// A plain starting table, the weights a first week tends to begin at. Replaced by the store.
    /// A barbell entry is the total on the bar, a dumbbell entry is the weight in each hand, and a
    /// bodyweight lift is left out: it starts at bodyweight with nothing added. The heavy lifts
    /// appear twice because GZCLP trains them twice: squat is T1 at 60 and T2 at 40.
    /// </summary>
    private static readonly Dictionary<ExerciseSlot, ExerciseState> StarterWeights = new()
    {
        [new("squat", 1)] = ExerciseState.Starting(60m),
        [new("squat", 2)] = ExerciseState.Starting(40m),
        [new("bench-press", 1)] = ExerciseState.Starting(45m),
        [new("bench-press", 2)] = ExerciseState.Starting(30m),
        [new("overhead-press", 1)] = ExerciseState.Starting(30m),
        [new("overhead-press", 2)] = ExerciseState.Starting(20m),
        [new("deadlift", 1)] = ExerciseState.Starting(70m),
        [new("deadlift", 2)] = ExerciseState.Starting(50m),
        [new("dumbbell-row", 3)] = ExerciseState.Starting(22.5m),
        [new("dumbbell-curl", 3)] = ExerciseState.Starting(12.5m),
        [new("dumbbell-lateral-raise", 3)] = ExerciseState.Starting(7.5m),
    };

    private string _dayKey = "";
    private bool _editing;

    // Built when the day changes rather than on every render: the plan is a fresh object graph
    // and the screen holds a parameter reference to it.
    private LiftSessionPlan _plan = null!;

    protected override void OnParametersSet()
    {
        _dayKey = _dayKey is { Length: > 0 } && Program.Rotation.Contains(_dayKey)
            ? _dayKey
            : DayKey ?? Program.Rotation[0];

        Resolve();
    }

    private void Resolve() => _plan = LiftSessionBuilder.For(Program, _dayKey, ExerciseStates);

    private void OnDayChanged(string dayKey)
    {
        _dayKey = dayKey;
        Resolve();
    }

    /// <summary>The lifts of a day, so the picker reads as "A1 · squat, bench press, chin up".</summary>
    private string Summary(string key) =>
        string.Join(", ", Program.Day(key).Exercises.Select(e => string.Join(' ', e.ExerciseId.Split('-'))));

    private void ToggleEditing() => _editing = !_editing;
}
