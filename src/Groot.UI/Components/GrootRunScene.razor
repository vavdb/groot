@* The run screen, and nothing around it. The panel's own header carries the program, the week
   and the session, so there is no second copy of any of that: the pencil beside the session dots
   opens the picker in place, and closes it again. Both heads embed this; the head-specific
   inputs are Programs, ShowProgram, the cue player, and the audio callbacks. *@
@using Groot.Core.Intervals
@using Groot.Core.Programs
@using Groot.UI.Audio

<div class="run-scene">
    @if (Selection is { } selected)
    {
        <RunScreen @key="SessionKey(selected)"
                   Session="selected.Session"
                   CuePlayer="@(ShowAudioControls && !SoundEnabled ? null : CuePlayer)"
                   Language="Language"
                   SessionsInWeek="selected.SessionsInWeek">
            <HeaderAction>
                <MudIconButton Icon="@(_editing ? Icons.Material.Filled.Check : Icons.Material.Filled.Edit)"
                               Size="Size.Small"
                               aria-label="@(_editing ? "Done choosing session" : "Change session")"
                               OnClick="ToggleEditing" />
            </HeaderAction>
            <ChildContent>
                @Picker
            </ChildContent>
        </RunScreen>
    }
    else
    {
        @Picker
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<IntervalProgram> Programs { get; set; } = [];

    /// <summary>Where cues are spoken. Null keeps the screen silent but usable.</summary>
    [Parameter] public ICuePlayer? CuePlayer { get; set; }

    /// <summary>Show the program selector (false for a single fixed program).</summary>
    [Parameter] public bool ShowProgram { get; set; } = true;

    /// <summary>Show the voice/sound controls (web) or omit them (phone heads).</summary>
    [Parameter] public bool ShowAudioControls { get; set; } = true;

    /// <summary>Raised when the voice language or sound toggle changes. Web maps this onto its cue player.</summary>
    [Parameter] public EventCallback<GrootAudioState> AudioChanged { get; set; }

    private string _programId = "";
    private int _week;
    private int _day;
    private bool _editing;
    private string Language { get; set; } = "en";
    private bool SoundEnabled { get; set; } = true;

    /// <summary>Keys the run screen: a new program, week or day rebuilds the timer instead of reusing it.</summary>
    private static string SessionKey(GrootProgramSelection selection) =>
        $"{selection.Session.Id?.ProgramName}-{selection.Session.Id?.Week}-{selection.Session.Id?.Day}";

    /// <summary>The controls, which appear inside the panel while the pencil is open.</summary>
    private RenderFragment Picker => __builder =>
    {
        <GrootProgramPicker Programs="Programs"
                            ShowProgram="ShowProgram"
                            ShowControls="_editing"
                            ProgramId="_programId"
                            ProgramIdChanged="OnProgramChanged"
                            Week="_week"
                            WeekChanged="OnWeekChanged"
                            Day="_day"
                            DayChanged="OnDayChanged">
            @if (ShowAudioControls)
            {
                <GrootAudioControls @bind-Language="Language"
                                    @bind-Sound="SoundEnabled"
                                    ValuesChanged="OnAudioChanged" />
            }
        </GrootProgramPicker>
    };

    private IntervalProgram SelectedProgram =>
        Programs.FirstOrDefault(p => p.Id == _programId) ?? Programs[0];

    // Resolved when the choice changes, not on every render: building a RunSession walks the
    // program's segments, and the markup reads it twice.
    private GrootProgramSelection? _selection;

    private GrootProgramSelection? Selection => _selection;

    protected override void OnParametersSet()
    {
        if (Programs.Count == 0) return;
        if (Programs.All(p => p.Id != _programId)) _programId = Programs[0].Id;
        if (!SelectedProgram.WeekNumbers.Contains(_week)) _week = SelectedProgram.WeekNumbers[0];
        if (!RunSession.DaysOf(SelectedProgram, _week).Contains(_day)) _day = RunSession.DaysOf(SelectedProgram, _week)[0];

        Resolve();
    }

    private void Resolve() =>
        _selection = Programs.Count == 0 ? null
            : new GrootProgramSelection(
                RunSession.For(SelectedProgram, _week, _day),
                SelectedProgram.Week(_week).SessionsPerWeek);

    private void ToggleEditing() => _editing = !_editing;

    private void OnProgramChanged(string programId)
    {
        _programId = programId;
        _week = SelectedProgram.WeekNumbers[0];
        _day = RunSession.DaysOf(SelectedProgram, _week)[0];
        Resolve();
    }

    /// <summary>A week can be shorter than the one before it, so the day follows it down.</summary>
    private void OnWeekChanged(int week)
    {
        _week = week;
        var days = RunSession.DaysOf(SelectedProgram, _week);
        if (!days.Contains(_day)) _day = days[0];
        Resolve();
    }

    private void OnDayChanged(int day)
    {
        _day = day;
        Resolve();
    }

    private Task OnAudioChanged() => AudioChanged.InvokeAsync(new GrootAudioState(Language, SoundEnabled));
}
