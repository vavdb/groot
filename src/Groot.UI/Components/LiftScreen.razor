@* The lifting screen: one training day, exercise by exercise. Tapping the active circle logs
   that set at its target and starts the rest clock; tapping it again takes the log back. The
   AMRAP set logs its target first and the stepper beside it records what actually happened.
   Plate maths and the session plan come from Groot.Core; this screen keeps only what is logged
   and how long the rest has left. *@
@using System.Diagnostics
@using Groot.Core.Equipment
@using Groot.Core.Programs
@using Groot.UI.Theme
@using Groot.Core.Sessions
@implements IDisposable

<section class="lift-screen" aria-label="@Heading">
    <MudStack Spacing="3">
        @* In a head with an app bar the heading lives there; on its own (the gallery) it stays
           at the top of the screen. Same fragment either way. *@
        @if (AppBar is null)
        {
            @Header
        }

        @ChildContent

        @* How long the session has been going, and the control for it. At the top, above the
           first exercise, because it covers the whole session rather than any one lift. Logging
           a set starts it, so the button is for the times it is wrong: a warmup before the first
           set, or a break in the middle. *@
        <div class="session-clock">
            <span class="clock-time">@Clock(SessionSeconds)</span>
            <span class="clock-state">@SessionState</span>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="clock-button" OnClick="ToggleSessionClock">
                @(_sessionRunning ? "⏸ Pause" : _sessionStarted ? "▶ Resume" : "Start ▶")
            </MudButton>
        </div>

        @foreach (var exercise in Plan.Exercises)
        {
            <GrootPanel Filled="true" Class="@($"exercise{(IsComplete(exercise) ? " complete" : "")}")">
                <div class="ex-head">
                    <span class="ex-title">
                        <span class="ex-name">@Name(exercise.ExerciseId)</span>
                        <span class="tier">T@(exercise.Tier)</span>
                    </span>
                    <span class="scheme">@exercise.Scheme.Text</span>
                    <button type="button" class="load-value editable"
                            aria-expanded="@(_editingWeight == exercise.ExerciseId)"
                            aria-label="@($"Change the weight, {Name(exercise.ExerciseId)}")"
                            @onclick="@(() => ToggleWeightEditor(exercise))">@Load(exercise)</button>
                </div>

                <div class="plates">@Plates(exercise)</div>

                @if (_editingWeight == exercise.ExerciseId)
                {
                    var editing = WeightOf(exercise) ?? 0m;
                    <div class="weight-pop">
                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                                       aria-label="Lighter" OnClick="@(() => NudgeWeight(exercise, -1))" />
                        <MudNumericField T="decimal" Value="editing" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Step="@Step(exercise)" HideSpinButtons="true" Immediate="true"
                                         Adornment="Adornment.End" AdornmentText="kg" Class="weight-field"
                                         ValueChanged="@(kg => SetWeight(exercise, kg))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                       aria-label="Heavier" OnClick="@(() => NudgeWeight(exercise, 1))" />
                        <span class="pop-hint">
                            @(exercise.Loading == LoadingKind.Bodyweight ? "added, or below zero for an assist · " : "")from set @(NextIndex(exercise) + 1) on
                        </span>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="CloseWeightEditor">Done</MudButton>
                    </div>
                }

                <div class="sets">
                    @foreach (var set in exercise.Sets)
                    {
                        <SetCircle State="StateOf(exercise, set)"
                                   Reps="RepsOf(exercise, set)"
                                   OnTap="@(() => ToggleAsync(exercise, set))" />
                    }

                </div>

                @if (InFocus(exercise) is { } focus)
                {
                    <div class="setrow">
                        <span class="setrow-label">set @(focus.Index + 1)</span>

                        @if (IsDone(exercise, focus))
                        {
                            <div class="reps">
                                <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                                               aria-label="@($"One rep fewer on set {focus.Index + 1}")"
                                               OnClick="@(() => NudgeReps(exercise, focus, -1))" />
                                <span class="reps-count @(IsMissed(exercise, focus) ? "missed" : "")">@_logged[(exercise.ExerciseId, focus.Index)]</span>
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                               aria-label="@($"One rep more on set {focus.Index + 1}")"
                                               OnClick="@(() => NudgeReps(exercise, focus, 1))" />
                                <span class="reps-of">of @focus.TargetReps</span>
                            </div>

                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       OnClick="@(() => Undo(exercise, focus))">Undo</MudButton>
                        }
                        else
                        {
                            <span class="setrow-target">@focus.TargetReps reps at @SetLoad(exercise, focus)@(focus.IsAmrap ? " or more" : "")</span>
                        }
                    </div>
                }

                @if (IsComplete(exercise))
                {
                    <div class="next">@NextLine(exercise)</div>
                }

                @if (RestingIn(exercise) is { } remaining)
                {
                    <div class="rest" aria-live="polite">
                        <span class="rest-time">rest @Clock(remaining)@(Started(exercise) ? "" : " · before this lift")</span>
                        <MudProgressLinear Color="Color.Primary" Rounded="true"
                                           Value="@RestPercent(exercise, remaining)" Class="rest-bar" />
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="EndRest">Skip</MudButton>
                    </div>
                }
            </GrootPanel>
        }

        @if (Finished)
        {
            <GrootPanel Filled="true" Class="summary">
                <MudText Typo="Typo.h5" Class="g-serif big">Done · @TotalReps reps</MudText>
                <MudText Typo="Typo.caption" Class="subt">@Plan.TotalSets sets · @Volume kg lifted</MudText>
            </GrootPanel>
        }

        <GrootStats>
            <GrootStat Label="sets" Value="@($"{LoggedSets}/{Plan.TotalSets}")" />
            <GrootStat Label="reps" Value="@TotalReps.ToString()" />
            <GrootStat Label="volume" Value="@($"{Volume} kg")" />
        </GrootStats>
    </MudStack>
</section>

@code {
    private const int TickMilliseconds = 250;

    /// <summary>The session clock only shows whole seconds, so it redraws once a second.</summary>
    private const int SessionTickMilliseconds = 1000;

    /// <summary>The day to train. Replacing it needs an <c>@key</c> so the log does not carry over.</summary>
    [Parameter, EditorRequired] public LiftSessionPlan Plan { get; set; } = null!;

    /// <summary>What is available to load: the bar and the plates. Never a bar-weight assumption.</summary>
    [Parameter] public EquipmentProfile Equipment { get; set; } = EquipmentProfile.Rack;

    /// <summary>A control beside the session dots, for whatever the owner puts there (the session pencil).</summary>
    [Parameter] public RenderFragment? HeaderAction { get; set; }

    /// <summary>Content directly under the header. The owner's session editor lives here.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The program behind the plan, which is what knows where a failure leads.</summary>
    [Parameter] public LiftProgram? Program { get; set; }

    /// <summary>The rung of the fail ladder each exercise is on. Absent means the first.</summary>
    [Parameter] public IReadOnlyDictionary<string, int> Stages { get; set; } = new Dictionary<string, int>();

    [Parameter] public EventCallback OnFinished { get; set; }

    // Logged reps per set, keyed by exercise and set index. Absent means the set is not done.
    private readonly Dictionary<(string Exercise, int Set), int> _logged = [];

    // Weight changes, keyed the same way. A change applies from that set to the end of the
    // exercise: "the second set felt easy, take the rest at 65" is one tap, not four.
    private readonly Dictionary<(string Exercise, int Set), decimal> _weights = [];

    // Which set each exercise's editor row is pointing at. Tapping a circle moves it there;
    // otherwise it follows the set about to be taken, or the last one logged.
    private readonly Dictionary<string, int> _focus = [];

    private string? _editingWeight;

    private CancellationTokenSource? _restLoop;
    private string? _restingExercise;
    private long _restEndsAtMs;

    // The session clock. Milliseconds accumulated across the running stretches, plus the
    // timestamp the current stretch resumed at; the same monotonic clock the rest uses, so a
    // change to the wall clock cannot move either.
    private CancellationTokenSource? _sessionLoop;
    private long _sessionElapsedMs;
    private long _sessionResumeMs;
    private bool _sessionStarted;
    private bool _sessionRunning;

    private int LoggedSets => _logged.Count;

    private int TotalReps => _logged.Values.Sum();

    private bool Finished => LoggedSets == Plan.TotalSets;

    private string Heading => $"{Plan.ProgramName} {Plan.DayKey}";

    /// <summary>The app bar of the head this screen is open in, or null in the gallery.</summary>
    [CascadingParameter] public GrootAppBar? AppBar { get; set; }

    /// <summary>
    /// The heading: which program, which day of the rotation, and the control that changes it.
    /// Own elements rather than a MudStack, because a head renders this in its app bar, where a
    /// component root would carry none of this file's scoped styles.
    /// </summary>
    private RenderFragment Header => __builder =>
    {
        <div class="lift-head">
            <div class="lift-title">
                <MudText Typo="Typo.h6" Class="g-serif">
                    @ShortName <MudText Typo="Typo.caption" Inline="true" Class="dim">@Plan.DayKey</MudText>
                </MudText>
                @HeaderAction
            </div>
        </div>
    };

    protected override void OnParametersSet() => AppBar?.Set(this, Header);

    /// <summary>The program name without its parenthetical, so the header stays one line on a phone.</summary>
    private string ShortName =>
        Plan.ProgramName.Split(" (", StringSplitOptions.TrimEntries)[0];

    /// <summary>Reps times the weight on the bar, rounded to whole kilos; bodyweight work adds nothing.</summary>
    private decimal Volume => Math.Round(Plan.Exercises.Sum(exercise =>
        exercise.Sets.Where(set => IsDone(exercise, set))
            .Sum(set => Moved(exercise, WeightAt(exercise, set.Index)) * _logged[(exercise.ExerciseId, set.Index)])), 0);

    /// <summary>The load one rep moves: both dumbbells, the bar, or whatever was added to bodyweight.</summary>
    private static decimal Moved(LiftExercisePlan exercise, decimal? kg) => exercise.Loading switch
    {
        LoadingKind.Dumbbell => 2m * (kg ?? 0m),
        LoadingKind.Bodyweight => Math.Max(0m, kg ?? 0m),
        _ => kg ?? 0m,
    };

    private static string Clock(int seconds) => GrootFormat.Clock(seconds);

    /// <summary>"bench-press" reads as "Bench press" until there are resource strings to look up.</summary>
    private static string Name(string exerciseId) =>
        string.Join(' ', exerciseId.Split('-')) is { Length: > 0 } words
            ? char.ToUpperInvariant(words[0]) + words[1..]
            : exerciseId;

    /// <summary>What the weight reads as, which follows how the exercise is loaded.</summary>
    private string Load(LiftExercisePlan exercise) => Weight(exercise.Loading, WeightOf(exercise));

    private static string Weight(LoadingKind loading, decimal? kg) => loading switch
    {
        LoadingKind.Bodyweight => kg switch
        {
            null or 0m => "bodyweight",
            < 0m => $"assisted {GrootFormat.Kilograms(-kg.Value)}",
            _ => $"bodyweight + {GrootFormat.Kilograms(kg.Value)}",
        },
        LoadingKind.Dumbbell => kg is { } perHand ? $"{GrootFormat.Kilograms(perHand)} each" : "no weight yet",
        _ => kg is { } total ? GrootFormat.Kilograms(total) : "no weight yet",
    };

    /// <summary>The weight one set is taken at, for the editor row.</summary>
    private string SetLoad(LiftExercisePlan exercise, LiftSet set) =>
        Weight(exercise.Loading, WeightAt(exercise, set.Index));

    /// <summary>The weight the next set will be taken at: the one the header shows and the editor changes.</summary>
    private decimal? WeightOf(LiftExercisePlan exercise) => WeightAt(exercise, NextIndex(exercise));

    /// <summary>Where a weight change lands: the next set to take, or the last one when the exercise is done.</summary>
    private int NextIndex(LiftExercisePlan exercise) => NextSet(exercise)?.Index ?? exercise.Sets.Count - 1;

    /// <summary>The weight for one set: the last change at or before it, or the planned target.</summary>
    private decimal? WeightAt(LiftExercisePlan exercise, int setIndex)
    {
        var changed = _weights
            .Where(w => w.Key.Exercise == exercise.ExerciseId && w.Key.Set <= setIndex)
            .OrderByDescending(w => w.Key.Set)
            .Select(w => (decimal?)w.Value)
            .FirstOrDefault();

        return changed ?? exercise.TargetKg;
    }

    /// <summary>How much one tap moves the bar: the program's increment for that exercise.</summary>
    private decimal Step(LiftExercisePlan exercise) =>
        Program?.TierFor(exercise.Tier).IncrementFor(exercise.ExerciseId) is { } kg and > 0m ? kg : 2.5m;

    /// <summary>An exercise with no weight yet starts from zero rather than ignoring the tap.</summary>
    private void NudgeWeight(LiftExercisePlan exercise, int direction) =>
        SetWeight(exercise, (WeightOf(exercise) ?? 0m) + direction * Step(exercise));

    private string Plates(LiftExercisePlan exercise)
    {
        if (exercise.Loading == LoadingKind.Dumbbell)
            return WeightOf(exercise) is { } perHand ? $"{GrootFormat.Kilograms(2 * perHand)} in both hands" : "";

        if (exercise.Loading == LoadingKind.Bodyweight)
            return WeightOf(exercise) is { } adjustment && adjustment != 0m
                ? adjustment > 0m ? "belt or vest" : "band or machine assist"
                : "";

        if (WeightOf(exercise) is not { } kg || Equipment.Plates.Count == 0) return "";

        var breakdown = Equipment.PerSide(kg);
        if (breakdown is null) return $"{Equipment.Bar.Name} cannot be loaded to {GrootFormat.Kilograms(kg)}";
        if (breakdown.Count == 0) return $"{Equipment.Bar.Name} alone";

        return $"{GrootFormat.Number(Equipment.Bar.EffectiveBarKg)} + {string.Join(" + ", breakdown.Select(GrootFormat.Number))} per side";
    }

    private bool IsDone(LiftExercisePlan exercise, LiftSet set) =>
        _logged.ContainsKey((exercise.ExerciseId, set.Index));

    private bool IsComplete(LiftExercisePlan exercise) =>
        exercise.Sets.All(set => IsDone(exercise, set));

    private SetCircleState StateOf(LiftExercisePlan exercise, LiftSet set)
    {
        if (IsMissed(exercise, set)) return SetCircleState.Missed;
        if (IsDone(exercise, set)) return SetCircleState.Done;
        return NextSet(exercise)?.Index == set.Index ? SetCircleState.Active : SetCircleState.Pending;
    }

    private LiftSet? NextSet(LiftExercisePlan exercise) =>
        exercise.Sets.FirstOrDefault(set => !IsDone(exercise, set));

    private int? RepsOf(LiftExercisePlan exercise, LiftSet set) =>
        _logged.TryGetValue((exercise.ExerciseId, set.Index), out var reps) ? reps
        : StateOf(exercise, set) == SetCircleState.Active ? set.TargetReps
        : null;

    /// <summary>The set logged most recently, which is the one the reps stepper corrects.</summary>
    private LiftSet? LastLogged(LiftExercisePlan exercise) =>
        exercise.Sets.LastOrDefault(set => IsDone(exercise, set));

    /// <summary>A set logged short of its target. Missing one is what sends a lift down the ladder.</summary>
    private bool IsMissed(LiftExercisePlan exercise, LiftSet set) =>
        _logged.TryGetValue((exercise.ExerciseId, set.Index), out var reps) && reps < set.TargetReps;

    private void NudgeReps(LiftExercisePlan exercise, LiftSet set, int delta)
    {
        var key = (exercise.ExerciseId, set.Index);
        if (!_logged.TryGetValue(key, out var reps)) return;

        _logged[key] = Math.Max(0, reps + delta);
    }

    /// <summary>What this exercise did, in the terms the progression rules read.</summary>
    private ExerciseOutcome Outcome(LiftExercisePlan exercise) =>
        new(exercise.ExerciseId,
            exercise.Tier,
            WeightAt(exercise, 0) ?? 0m,
            Stages.GetValueOrDefault(exercise.ExerciseId),
            AllSetsCompleted: exercise.Sets.All(set => !IsMissed(exercise, set)),
            TotalReps: exercise.Sets.Sum(set => _logged.GetValueOrDefault((exercise.ExerciseId, set.Index))),
            AmrapReps: exercise.Sets.LastOrDefault(set => set.IsAmrap) is { } amrap
                ? _logged.GetValueOrDefault((exercise.ExerciseId, amrap.Index))
                : null);

    /// <summary>Where the next session starts for this lift, once every set of it is logged.</summary>
    private string NextLine(LiftExercisePlan exercise)
    {
        if (Program is null || WeightAt(exercise, 0) is null) return "";

        var next = LiftProgressionPlanner.Next(Program, Outcome(exercise));
        return $"next · {GrootFormat.Kilograms(next.WeightKg)}, {next.Scheme.Text} · {next.Explanation}";
    }

    /// <summary>The set the editor row is on: the tapped one, else the next to take, else the last taken.</summary>
    private LiftSet? InFocus(LiftExercisePlan exercise)
    {
        if (_focus.TryGetValue(exercise.ExerciseId, out var index))
            return exercise.Sets.FirstOrDefault(set => set.Index == index);

        return NextSet(exercise) ?? LastLogged(exercise);
    }

    private int SetInFocus(LiftExercisePlan exercise) => InFocus(exercise)?.Index ?? 0;

    /// <summary>Tapping a set logs it at its target; tapping a logged one just moves the editor there.</summary>
    private async Task ToggleAsync(LiftExercisePlan exercise, LiftSet set)
    {
        _focus[exercise.ExerciseId] = set.Index;

        if (IsDone(exercise, set)) return;

        _logged[(exercise.ExerciseId, set.Index)] = set.TargetReps;
        StartSessionClockIfIdle();

        // The rest that follows the last set of a lift is the rest before the next lift, so it
        // is counted and shown there: the panel you are about to work in, at that lift's own
        // rest length. The last set of the day rests for nothing.
        StartRest(IsComplete(exercise) ? Following(exercise) : exercise);

        if (Finished)
        {
            EndRest();
            PauseSessionClock();
            await OnFinished.InvokeAsync();
        }
    }

    /// <summary>The lift after this one in the day's order, or null when it was the last.</summary>
    private LiftExercisePlan? Following(LiftExercisePlan exercise)
    {
        var index = Plan.Exercises.ToList().FindIndex(e => e.ExerciseId == exercise.ExerciseId);
        return index >= 0 && index + 1 < Plan.Exercises.Count ? Plan.Exercises[index + 1] : null;
    }

    private void PauseSessionClock()
    {
        if (_sessionRunning) ToggleSessionClock();
    }

    /// <summary>Takes a logged set back and leaves the editor on it.</summary>
    private void Undo(LiftExercisePlan exercise, LiftSet set)
    {
        _logged.Remove((exercise.ExerciseId, set.Index));
        EndRest();
    }

    private void ToggleWeightEditor(LiftExercisePlan exercise) =>
        _editingWeight = _editingWeight == exercise.ExerciseId ? null : exercise.ExerciseId;

    private void CloseWeightEditor() => _editingWeight = null;

    /// <summary>Sets the weight from the next set onward. Sets already taken keep what they were taken at.</summary>
    private void SetWeight(LiftExercisePlan exercise, decimal kg) =>
        _weights[(exercise.ExerciseId, NextIndex(exercise))] =
            exercise.Loading == LoadingKind.Bodyweight ? kg : Math.Max(0m, kg);

    /// <summary>How long the session has been going, not counting the stretches it was paused.</summary>
    private int SessionSeconds =>
        (int)((_sessionElapsedMs + (_sessionRunning ? NowMs() - _sessionResumeMs : 0)) / 1000);

    private string SessionState => _sessionRunning ? "session" : _sessionStarted ? "paused" : "not started";

    /// <summary>Whether a set of this exercise has been taken, which is what makes a rest before it read right.</summary>
    private bool Started(LiftExercisePlan exercise) =>
        exercise.Sets.Any(set => IsDone(exercise, set));

    private void ToggleSessionClock()
    {
        if (_sessionRunning)
        {
            _sessionElapsedMs += NowMs() - _sessionResumeMs;
            _sessionRunning = false;
            StopSessionLoop();
            return;
        }

        _sessionStarted = true;
        _sessionRunning = true;
        _sessionResumeMs = NowMs();

        StopSessionLoop();
        var cts = new CancellationTokenSource();
        _sessionLoop = cts;
        _ = TickSessionAsync(cts.Token);
    }

    /// <summary>The clock runs from the first set logged, for the sessions nobody thought to start.</summary>
    private void StartSessionClockIfIdle()
    {
        if (!_sessionRunning) ToggleSessionClock();
    }

    private void StopSessionLoop()
    {
        _sessionLoop?.Cancel();
        _sessionLoop?.Dispose();
        _sessionLoop = null;
    }

    private async Task TickSessionAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(SessionTickMilliseconds, token);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Paused, finished, or the screen went away.
        }
        catch (ObjectDisposedException)
        {
            // StopSessionLoop disposed the token source while this loop was between ticks.
        }
    }

    private int? RestingIn(LiftExercisePlan exercise)
    {
        if (_restingExercise != exercise.ExerciseId) return null;

        var remaining = (int)Math.Ceiling((_restEndsAtMs - NowMs()) / 1000.0);
        return remaining > 0 ? remaining : null;
    }

    private double RestPercent(LiftExercisePlan exercise, int remaining) =>
        exercise.RestSeconds == 0 ? 100 : 100.0 * (exercise.RestSeconds - remaining) / exercise.RestSeconds;

    private static long NowMs() => (long)(Stopwatch.GetTimestamp() * 1000.0 / Stopwatch.Frequency);

    private void StartRest(LiftExercisePlan? exercise)
    {
        EndRest();
        if (exercise is null || exercise.RestSeconds <= 0) return;

        _restingExercise = exercise.ExerciseId;
        _restEndsAtMs = NowMs() + exercise.RestSeconds * 1000L;

        var cts = new CancellationTokenSource();
        _restLoop = cts;
        _ = TickRestAsync(cts.Token);
    }

    private void EndRest()
    {
        _restLoop?.Cancel();
        _restLoop?.Dispose();
        _restLoop = null;
        _restingExercise = null;
    }

    private async Task TickRestAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && NowMs() < _restEndsAtMs)
            {
                await Task.Delay(TickMilliseconds, token);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The rest was skipped or the screen went away; nothing to clean up beyond Dispose.
        }
        catch (ObjectDisposedException)
        {
            // EndRest cancelled and disposed the token source while this loop was between ticks.
        }

        if (!token.IsCancellationRequested)
        {
            _restingExercise = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        AppBar?.Clear(this);
        EndRest();
        StopSessionLoop();
    }
}
