<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Groot.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.*" />
    <PackageReference Include="MudBlazor" Version="9.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Groot.Core\Groot.Core.csproj" />
  </ItemGroup>

  <!-- Builds tools/Groot.Palette.Generator and runs it to write wwwroot/tokens.css from GrootPalette.cs.
       The generator's own sources are inputs too: changing how tokens are emitted has to regenerate
       them, and on a fresh clone the palette and the stylesheet carry the same timestamp, which used
       to make MSBuild skip this target and let CI's tokens.css diff pass without ever running it. -->
  <Target Name="GenerateTokensCss"
          BeforeTargets="CoreCompile"
          Inputs="$(MSBuildProjectDirectory)/Theme/GrootPalette.cs;$(MSBuildProjectDirectory)/../../tools/Groot.Palette.Generator/Program.cs"
          Outputs="$(MSBuildProjectDirectory)/obj/$(Configuration)/tokens.stamp">
    <MSBuild Projects="$(MSBuildProjectDirectory)/../../tools/Groot.Palette.Generator/Groot.Palette.Generator.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <PropertyGroup>
      <_Generator>$(MSBuildProjectDirectory)/../../tools/Groot.Palette.Generator/bin/$(Configuration)/net10.0/Groot.Palette.Generator.dll</_Generator>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(_Generator)&quot; &quot;$(MSBuildProjectDirectory)/Theme/GrootPalette.cs&quot; &quot;$(MSBuildProjectDirectory)/wwwroot/tokens.css&quot;" />
    <Touch Files="$(MSBuildProjectDirectory)/obj/$(Configuration)/tokens.stamp" AlwaysCreate="true" />
  </Target>

</Project>
