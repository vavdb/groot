@page "/run"
@using Groot.Core.Programs
@using Groot.UI.Components
@using Groot.Web.Audio
@inject WebCuePlayer Cues

<PageTitle>Run · Groot</PageTitle>

<GrootRunScene Programs="ProgramCatalog.Embedded.IntervalPrograms"
               CuePlayer="Cues"
               ShowProgram="true"
               ShowAudioControls="true"
               AudioChanged="OnAudioChanged" />

@code {
    private void OnAudioChanged(GrootAudioState state) =>
        Cues.Language = state.Language == "nl" ? "nl-NL" : "en-GB";
}
